# Ghostty configuration — managed by dotfiles (symlinked from ~/.dotfiles/.config/ghostty/config).
#
# Theme, font, and design are intentionally left open — design these directly.
# Reference:  ghostty +show-config --default --docs
#             https://ghostty.org/docs/config
#
# Prompt note: the shell picks Starship automatically in Ghostty
# (TERM_PROGRAM=ghostty branch in ~/.dotfiles/.zshrc). A Nerd Font is
# recommended once you choose a font, so prompt glyphs render.

# --- Theme / appearance ---
# reader-dark lives in ~/.config/ghostty/themes/ (linked by install.sh).
# Reload after edits: cmd+shift+, (no file watch).
theme = reader-dark

# Font fallback chain: JetBrains Mono (Latin/code, the reader palette's code
# font) -> D2Coding (Hangul; the embedded JetBrains Mono has no Hangul glyphs,
# so Korean otherwise rendered via a random macOS fallback). Both installed by
# the Brewfile. Nerd symbols come from Ghostty's built-in fallback.
font-family = JetBrains Mono
font-family = D2Coding
# background-opacity stays unset: the reader canvas is an opaque page.
font-size = 14
window-padding-x = 10
window-padding-y = 8

# --- Ergonomics (uncomment if wanted) ---
# macos-option-as-alt = true

# Keep Ghostty SSH sessions compatible with hosts lacking xterm-ghostty terminfo.
shell-integration-features = cursor,no-sudo,title,ssh-env,no-ssh-terminfo,path
