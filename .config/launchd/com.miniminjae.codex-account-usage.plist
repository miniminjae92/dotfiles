<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.miniminjae.codex-account-usage</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/miniminjae/.local/bin/codex-account-usage</string>
    <string>monitor</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- 09:00 고정 트리거는 제거했다(2026-08-12). 아침 웨이크와 겹쳐
       Wi-Fi 붙기 전 실행을 유발했고, 15분 주기가 이미 있어 불필요하다.
       일일 보고는 9시 이후 첫 정주기 실행에서 나간다. -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/miniminjae/.local/state/codex-account-usage/monitor.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/miniminjae/.local/state/codex-account-usage/monitor.error.log</string>
</dict>
</plist>
