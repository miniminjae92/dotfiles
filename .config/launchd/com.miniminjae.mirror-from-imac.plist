<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.miniminjae.mirror-from-imac</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/miniminjae/.local/bin/mirror-from-imac</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- 1시간. 변경이 없어도 회당 2717개 파일을 대조하느라 4.5초가 든다.
       대시보드·세션 검색 모두 실시간성이 낮아 이 지연이 문제되지 않는다.
       즉시 필요하면 mirror-from-imac 을 직접 부르면 된다. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/miniminjae/.local/state/mirror-to-imac/from-imac.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/miniminjae/.local/state/mirror-to-imac/from-imac.error.log</string>
</dict>
</plist>
