<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.miniminjae.mirror-to-imac</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/miniminjae/.local/bin/mirror-to-imac</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- 1시간. 변경이 없어도 회당 2717개 파일을 대조하느라 4.5초가 든다.
       5분 주기면 하루 288회(21.6분), 1시간이면 24회(1.8분)다.
       즉시 필요하면 mirror-to-imac 을 직접 부르면 된다. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- ~/.local/bin 이 없으면 `command -v ops-event` 가드가 항상 실패해
         skip 텔레메트리가 구조적으로 불가시였다(2026-08-04 감사: 190회 중 skip 0). -->
    <key>PATH</key>
    <string>/Users/miniminjae/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/miniminjae/.local/state/mirror-to-imac/mirror.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/miniminjae/.local/state/mirror-to-imac/mirror.error.log</string>
</dict>
</plist>
