<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.miniminjae.session-harvest-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/miniminjae/.local/bin/session-harvest</string>
    <string>--days</string>
    <string>7</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- D-020 ⓐ: default 프로파일(~/.codex)이 고장이라 마이닝을 google 계정 래퍼로.
         PATH는 래퍼 체인(gcodex→codex-account→bare codex)이 launchd에서 homebrew
         codex를 찾지 못해 조용히 실패하는 것을 막는다. -->
    <key>PERSONAL_OPS_CODEX</key>
    <string>/Users/miniminjae/.local/bin/gcodex</string>
    <key>PATH</key>
    <string>/Users/miniminjae/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <!-- 목요일 저녁(2026-08-04 사용자 요청). 일요일 20:30은 주간 codex 쿼터가
         소진된 뒤라 마이닝이 한도로 실패하기 쉬웠다. -->
    <key>Weekday</key><integer>4</integer>
    <key>Hour</key><integer>20</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/miniminjae/.local/state/session-harvest/weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/miniminjae/.local/state/session-harvest/weekly.error.log</string>
</dict>
</plist>
