# 시스템 파일 (Mac 관련)
.DS_Store

# Vim/Neovim 관련 파일 (캐시, 백업, 스왑 파일)
*.sw[a-z]
.*.swp
Session.vim
nvim.log

# Eclipse/JDT가 로컬에서 다시 만드는 프로젝트 메타데이터는 추적하지 않는다.
# Java 소스 경로, 라이브러리, 빌드 출력 경로
.classpath
# 프로젝트 이름, 빌더, Java 프로젝트 성격(nature)
.project
# 컴파일러, 포매터 등 프로젝트별 Eclipse/JDT 설정
.settings/

# nvim/vim spell check 데이터
nvim/spell/
vim/spell/

# Python 관련 캐시 파일
*.py[cod]
__pycache__/

# 터미널 관련 파일 (zsh history)
.zsh_history

# SSH 설정 (보안 이슈)
.ssh/

# GPG 키 관련 (보안)
.gnupg/

**/.claude/settings.local.json

# 세션 인계 노트. 로컬 연속성용이라 저장소에 남기지 않는다.
# 영속 산출물은 mimir 볼트 00 Inbox/agent-handoffs/ 로 간다.
docs/conversation/
