filters:
  and:
    - file.ext == "md"
    - file.inFolder("00 Inbox")
properties:
  file.name:
    displayName: Note
  type:
    displayName: Type
  status:
    displayName: Status
  origin:
    displayName: Origin
  created:
    displayName: Created
views:
  - type: table
    name: Inbox
    order:
      - file.name
      - type
      - status
      - origin
      - created
