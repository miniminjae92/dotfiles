filters:
  and:
    - file.ext == "md"
    - file.inFolder("20 Knowledge")
    - file.name != "README"
properties:
  file.name:
    displayName: Knowledge
  type:
    displayName: Type
  status:
    displayName: Status
  origin:
    displayName: Origin
  confidence:
    displayName: Confidence
views:
  - type: table
    name: Knowledge
    order:
      - file.name
      - type
      - status
      - origin
      - confidence
