filters:
  and:
    - file.ext == "md"
    - type == "review" || type == "proposal" || type == "security-check" || type == "weekly-review"
    - '!file.inFolder("_System")'
properties:
  file.name:
    displayName: Review
  type:
    displayName: Type
  status:
    displayName: Status
  created:
    displayName: Created
  experiment_status:
    displayName: Experiment
views:
  - type: table
    name: Reviews and proposals
    order:
      - file.name
      - type
      - status
      - created
      - experiment_status
