{
  "statusLine": {
    "type": "command",
    "command": "if [ -x \"$HOME/.local/bin/claude-statusline\" ]; then \"$HOME/.local/bin/claude-statusline\"; else \"$HOME/.dotfiles/bin/claude-statusline\"; fi"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/agent-os-core-check\" ]; then \"$HOME/.local/bin/agent-os-core-check\" claude; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/agent-os-capture-event\" ]; then \"$HOME/.local/bin/agent-os-capture-event\"; fi",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/agent-os-tell-lint\" ]; then \"$HOME/.local/bin/agent-os-tell-lint\" --hook stop; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/agent-notify\" ]; then \"$HOME/.local/bin/agent-notify\" claude-hook; else \"$HOME/projects/agent-notify/bin/agent-notify\" claude-hook; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/explain-diff-gate\" ]; then \"$HOME/.local/bin/explain-diff-gate\" --hook pretooluse; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/agent-os-tell-lint\" ]; then \"$HOME/.local/bin/agent-os-tell-lint\" --hook posttooluse; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/ko-style-hook\" ]; then \"$HOME/.local/bin/ko-style-hook\"; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/agent-notify\" ]; then \"$HOME/.local/bin/agent-notify\" claude-hook; else \"$HOME/projects/agent-notify/bin/agent-notify\" claude-hook; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/agent-notify\" ]; then \"$HOME/.local/bin/agent-notify\" claude-hook; else \"$HOME/projects/agent-notify/bin/agent-notify\" claude-hook; fi",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
