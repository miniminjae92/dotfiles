      "organizations_url": "https://api.github.com/users/miniminjae92/orgs",
      "repos_url": "https://api.github.com/users/miniminjae92/repos",
      "events_url": "https://api.github.com/users/miniminjae92/events{/privacy}",
      "received_events_url": "https://api.github.com/users/miniminjae92/received_events",
