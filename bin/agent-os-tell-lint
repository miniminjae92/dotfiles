#!/usr/bin/env python3
"""agent-os-tell-lint — 에이전트 산출물의 '티(tell)'를 규칙 기반으로 검출.

"티 나니까 빼라"는 전역 문체 지시는 모델이 구조(불릿·표·강조)까지 걷어내
가독성을 무너뜨린다(2026-08-06 실측). 대신 티를 규칙 ID가 붙은 토큰 단위
deny-list로 컴파일해 결정론적으로 검사한다. 규칙 정본:
~/.dotfiles/agents/tell-rules.tsv (id, surfaces, threshold, pattern, message).

사용법:
  agent-os-tell-lint [--surface doc|chat|commit] FILE...   # CLI, 위반 시 exit 1
  echo TEXT | agent-os-tell-lint --surface commit          # stdin 린트
  agent-os-tell-lint --hook posttooluse                    # Claude PostToolUse(Write|Edit) 훅
  agent-os-tell-lint --hook stop                           # Claude Stop 훅(직전 응답 검사)

모드 (기본 warn):
  warn     위반을 ops-event(kind=finding, severity=low)로만 기록. 세션 무개입.
  enforce  {"decision":"block","reason":...} 출력 → 모델이 이유를 보고 해당
           토큰만 교체. --enforce 플래그 또는 TELL_LINT_MODE=enforce 로 전환.

훅 경로는 배관이다: 규칙 파일 부재·파싱 실패·전송 실패 어느 것도 세션을
깨뜨리지 않는다(조용히 exit 0). Stop 훅은 stop_hook_active로 재진입을 막는다.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys

SOURCE = "tell-lint"
SURFACES = ("doc", "chat", "commit")
MAX_FILE_BYTES = 1_000_000
MAX_TRANSCRIPT_TAIL = 2_000_000

FENCE_RE = re.compile(r"^\s*(?:```|~~~)")
INLINE_CODE_RE = re.compile(r"`[^`\n]+`")
URL_RE = re.compile(r"https?://\S+")


def rules_path() -> str:
    override = os.environ.get("TELL_LINT_RULES")
    if override:
        return os.path.expanduser(override)
    bin_dir = os.path.dirname(os.path.realpath(__file__))
    return os.path.join(os.path.dirname(bin_dir), "agents", "tell-rules.tsv")


class Rule:
    __slots__ = ("rid", "surfaces", "threshold", "regex", "message")

    def __init__(self, rid, surfaces, threshold, regex, message):
        self.rid = rid
        self.surfaces = surfaces
        self.threshold = threshold
        self.regex = regex
        self.message = message


def load_rules(path: str) -> list[Rule]:
    rules: list[Rule] = []
    try:
        fh = open(path, encoding="utf-8")
    except OSError as err:
        sys.stderr.write(f"agent-os-tell-lint: 규칙 파일 열기 실패, 규칙 0개로 진행: {err}\n")
        return rules
    with fh:
        for lineno, line in enumerate(fh, 1):
            line = line.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) != 5:
                sys.stderr.write(f"agent-os-tell-lint: {path}:{lineno} 탭 구분 5필드가 아님, 무시\n")
                continue
            rid, surfaces, threshold, pattern, message = (p.strip() for p in parts)
            try:
                rules.append(
                    Rule(rid, {s.strip() for s in surfaces.split(",")}, int(threshold),
                         re.compile(pattern), message)
                )
            except (ValueError, re.error) as err:
                sys.stderr.write(f"agent-os-tell-lint: {path}:{lineno} 규칙 파싱 실패({err}), 무시\n")
    return rules


def _blank(match: re.Match) -> str:
    return " " * len(match.group())


def strip_noise(text: str) -> str:
    """검사 제외 영역(frontmatter·코드 펜스·인라인 코드·URL)을 공백으로 치환.

    비개행 문자만 공백으로 바꿔 행 번호를 보존한다.
    """
    lines = text.split("\n")
    fm_end = -1
    if lines and lines[0].strip() == "---":
        for i in range(1, min(len(lines), 120)):
            if lines[i].strip() in ("---", "..."):
                fm_end = i
                break
    out: list[str] = []
    in_fence = False
    for i, line in enumerate(lines):
        if i <= fm_end:
            out.append("")
            continue
        if FENCE_RE.match(line):
            in_fence = not in_fence
            out.append("")
            continue
        if in_fence:
            out.append("")
            continue
        line = INLINE_CODE_RE.sub(_blank, line)
        line = URL_RE.sub(_blank, line)
        out.append(line)
    return "\n".join(out)


def lint(text: str, surface: str, rules: list[Rule]) -> list[dict]:
    cleaned = strip_noise(text)
    violations = []
    for rule in rules:
        if surface not in rule.surfaces:
            continue
        hits = list(rule.regex.finditer(cleaned))
        if len(hits) <= rule.threshold:
            continue
        line_nos = sorted({cleaned.count("\n", 0, m.start()) + 1 for m in hits})
        violations.append({
            "rule": rule.rid,
            "count": len(hits),
            "lines": line_nos[:5],
            "message": rule.message,
        })
    return violations


def print_report(name: str, violations: list[dict]) -> None:
    for v in violations:
        lines = ", ".join(str(n) for n in v["lines"])
        print(f"{name}:{v['lines'][0]}\t{v['rule']} {v['count']}회 (행 {lines})\t{v['message']}")


def build_reason(violations: list[dict], target: str) -> str:
    out = [
        f"에이전트 티 감지({target}). 아래 위반 토큰만 교체하라. "
        "구조(불릿·표·강조·헤더)와 내용은 그대로 유지한다:"
    ]
    for v in violations:
        lines = ", ".join(str(n) for n in v["lines"])
        out.append(f"- {v['rule']} {v['count']}회 (행 {lines}): {v['message']}")
    out.append("오탐이라 판단하면 수정 대신 사용자에게 규칙(~/.dotfiles/agents/tell-rules.tsv) 조정을 제안한다.")
    return "\n".join(out)


def ops_emit(surface: str, violations: list[dict], mode: str, severity: str, extra: dict | None = None) -> None:
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ops-event")
    if not os.access(exe, os.X_OK):
        exe = shutil.which("ops-event")
    if not exe:
        return
    pairs = [
        f"surface={surface}",
        f"mode={mode}",
        f"total={sum(v['count'] for v in violations)}",
    ]
    pairs += [f"{v['rule'].lower()}={v['count']}" for v in violations]
    pairs += [f"{k}={val}" for k, val in (extra or {}).items()]
    try:
        subprocess.run(
            [exe, "--source", SOURCE, "--kind", "finding", "--severity", severity, *pairs],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=3, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def last_assistant_text(path: str) -> str:
    """세션 transcript(jsonl) 꼬리에서 메인 체인의 마지막 assistant 텍스트를 추출."""
    if not path:
        return ""
    try:
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            tail = min(size, MAX_TRANSCRIPT_TAIL)
            fh.seek(size - tail)
            data = fh.read(tail)
    except OSError:
        return ""
    if tail < size and b"\n" in data:
        data = data.split(b"\n", 1)[1]
    for raw in reversed(data.decode("utf-8", "replace").splitlines()):
        raw = raw.strip()
        if not raw:
            continue
        try:
            obj = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if obj.get("type") != "assistant" or obj.get("isSidechain"):
            continue
        content = (obj.get("message") or {}).get("content")
        if isinstance(content, str):
            text = content
        elif isinstance(content, list):
            text = "\n".join(
                block.get("text", "")
                for block in content
                if isinstance(block, dict) and block.get("type") == "text"
            )
        else:
            continue
        if text.strip():
            return text
    return ""


def run_hook(which: str, enforce: bool, rules: list[Rule]) -> int:
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0
    if which == "posttooluse":
        if payload.get("tool_name") not in ("Write", "Edit", "MultiEdit"):
            return 0
        file_path = (payload.get("tool_input") or {}).get("file_path") or ""
        if not file_path.endswith(".md"):
            return 0
        try:
            with open(file_path, encoding="utf-8", errors="replace") as fh:
                text = fh.read(MAX_FILE_BYTES)
        except OSError:
            return 0
        surface, target, extra = "doc", os.path.basename(file_path), {"file": file_path}
    else:  # stop
        if payload.get("stop_hook_active"):
            return 0
        text = last_assistant_text(payload.get("transcript_path") or "")
        if not text:
            return 0
        surface, target, extra = "chat", "직전 응답", {}
    violations = lint(text, surface, rules)
    if not violations:
        return 0
    if enforce:
        ops_emit(surface, violations, "enforce", "medium", extra)
        print(json.dumps({"decision": "block", "reason": build_reason(violations, target)},
                         ensure_ascii=False))
    else:
        ops_emit(surface, violations, "warn", "low", extra)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="agent-os-tell-lint",
                                     description="에이전트 티(tell) 규칙 린터")
    parser.add_argument("--surface", choices=SURFACES, default="doc")
    parser.add_argument("--hook", choices=("posttooluse", "stop"))
    parser.add_argument("--enforce", action="store_true",
                        help="위반 시 block JSON 출력 (기본은 warn: ops-event 기록만)")
    parser.add_argument("--rules", help="규칙 TSV 경로 override")
    parser.add_argument("files", nargs="*")
    args = parser.parse_args()

    enforce = args.enforce or os.environ.get("TELL_LINT_MODE", "").strip().lower() == "enforce"
    rules = load_rules(os.path.expanduser(args.rules) if args.rules else rules_path())

    if args.hook:
        try:
            return run_hook(args.hook, enforce, rules)
        except Exception as err:  # 배관: 어떤 실패도 세션을 깨뜨리지 않는다
            sys.stderr.write(f"agent-os-tell-lint: 훅 처리 실패, 무시함: {err}\n")
            return 0

    found = False
    if args.files:
        for path in args.files:
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    text = fh.read(MAX_FILE_BYTES)
            except OSError as err:
                sys.stderr.write(f"agent-os-tell-lint: {err}\n")
                found = True
                continue
            violations = lint(text, args.surface, rules)
            found = found or bool(violations)
            print_report(os.path.basename(path), violations)
    else:
        violations = lint(sys.stdin.read(), args.surface, rules)
        found = bool(violations)
        print_report("stdin", violations)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
