#!/usr/bin/env bash
set -euo pipefail

# Snapshot each vault locally and mirror it to its private Git remote so the
# latest notes are readable on the phone (GitHub mobile app) without exposing a
# public site. Pushes are best-effort: an offline or auth-less run must never
# fail the launchd job, because the local commit already preserves history.
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10"

# 경로 계약(D-012): 환경변수 > agent-os/paths.env > 내장 기본값(fallback 시 이벤트)
paths_file="${DOTFILES_DIR:-$HOME/.dotfiles}/agent-os/paths.env"
paths_fallback=0
ygg_default="$(grep -m1 '^YGGDRASIL_VAULT=' "$paths_file" 2>/dev/null | cut -d= -f2-)" || ygg_default=""
dev_default="$(grep -m1 '^DEVELOPER_OS_VAULT=' "$paths_file" 2>/dev/null | cut -d= -f2-)" || dev_default=""
if [ -z "$ygg_default" ] || [ -z "$dev_default" ]; then
  paths_fallback=1
  ygg_default='$HOME/.obsidian/yggdrasil'
  dev_default='$HOME/.obsidian/mimir'
fi
vaults=(
  "${YGGDRASIL_VAULT:-${ygg_default/\$HOME/$HOME}}"
  "${DEVELOPER_OS_VAULT:-${dev_default/\$HOME/$HOME}}"
)
if [ "$paths_fallback" = 1 ]; then
  command -v ops-event >/dev/null 2>&1 &&
    ops-event --source vault-snapshot --kind error --severity low \
      reason=paths-contract-fallback 2>/dev/null || true
fi

committed=0
pushed=0
skipped=0
push_failed=0
conflicted=0

for vault in "${vaults[@]}"; do
  if ! git -C "$vault" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'agent-os-vault-snapshot: not a Git repository: %s\n' "$vault" >&2
    skipped=$((skipped + 1))
    continue
  fi

  git -C "$vault" add --all

  if ! git -C "$vault" diff --cached --quiet; then
    git -C "$vault" commit -m "docs: vault snapshot $(date '+%Y-%m-%d %H:%M')"
    committed=$((committed + 1))
  fi

  if git -C "$vault" remote get-url origin >/dev/null 2>&1; then
    branch="$(git -C "$vault" symbolic-ref --quiet --short HEAD || echo HEAD)"

    # 다른 기기(맥북↔아이맥)의 커밋을 먼저 당긴다. 이게 없으면 뒤처진 쪽의
    # push 가 non-fast-forward 로 거부되고, 거부될수록 더 뒤처지는 교착에 빠진다.
    # 충돌 시에는 반드시 abort 한다 — 무인 잡이 저장소를 rebase 중간 상태로
    # 남기면 다음 실행까지 연쇄로 깨지고 볼트에 충돌 마커가 노출된다.
    if git -C "$vault" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
      if ! git -C "$vault" pull --rebase --quiet origin "$branch" 2>/dev/null; then
        git -C "$vault" rebase --abort >/dev/null 2>&1 || true
        printf 'agent-os-vault-snapshot: pull conflict, manual merge needed: %s\n' "$vault" >&2
        conflicted=$((conflicted + 1))
        continue
      fi
    fi

    if ! git -C "$vault" push --quiet origin "$branch"; then
      printf 'agent-os-vault-snapshot: push skipped (offline/auth): %s\n' "$vault" >&2
      push_failed=$((push_failed + 1))
    else
      pushed=$((pushed + 1))
    fi
  fi
done

# 구조화 이벤트 1줄 (ops-digest 수집용). 텔레메트리 실패가 잡을 깨뜨리면 안 됨.
ops_event="$(command -v ops-event 2>/dev/null || true)"
if [ -z "$ops_event" ]; then
  ops_event="$HOME/.local/bin/ops-event"
fi
if [ -x "$ops_event" ]; then
  sev=info
  if [ "$push_failed" -gt 0 ]; then
    sev=low
  fi
  # 충돌은 사람이 풀어줄 때까지 그 볼트의 동기화가 멈춘다 — push 실패보다 위다.
  if [ "$conflicted" -gt 0 ]; then
    sev=medium
  fi
  "$ops_event" --source vault-snapshot --kind run --severity "$sev" \
    committed="$committed" pushed="$pushed" skipped="$skipped" push_failed="$push_failed" \
    conflicted="$conflicted" \
    2>/dev/null || true
fi
