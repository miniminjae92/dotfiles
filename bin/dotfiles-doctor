#!/usr/bin/env bash
# dotfiles-doctor: read-only health check for the dotfiles + agent environment.
# Verifies symlinks, required tools, agent CLI state, launchd jobs, and
# registry drift (routing.json vs Codex agent TOMLs vs models.json).
# Never changes state. Exit code: number of FAIL findings (capped at 125).
set -uo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
PASS=0 WARN=0 FAIL=0

ok()   { PASS=$((PASS + 1)); printf '\033[32mPASS\033[0m %s\n' "$1"; }
warn() { WARN=$((WARN + 1)); printf '\033[33mWARN\033[0m %s\n' "$1"; }
bad()  { FAIL=$((FAIL + 1)); printf '\033[31mFAIL\033[0m %s\n' "$1"; }

check_link() {
  local target="$1" expected="$2"
  if [ ! -e "$target" ]; then
    bad "link missing: $target"
  elif [ "$(readlink "$target" 2>/dev/null)" = "$expected" ]; then
    ok "link: $target"
  else
    bad "link drift: $target -> $(readlink "$target" 2>/dev/null || echo '(not a symlink)') (expected $expected)"
  fi
}

echo "== Symlinks =="
check_link "$HOME/.zshrc" "$DOTFILES_DIR/.zshrc"
check_link "$HOME/.tmux.conf" "$DOTFILES_DIR/.tmux.conf"
check_link "$HOME/.config/nvim" "$DOTFILES_DIR/.config/nvim"
check_link "$HOME/.config/zsh/git.zsh" "$DOTFILES_DIR/.config/zsh/git.zsh"
check_link "$HOME/.config/ghostty/themes/reader-dark" "$DOTFILES_DIR/.config/ghostty/themes/reader-dark"
check_link "$HOME/.codex/AGENTS.md" "$DOTFILES_DIR/agents/AGENTS.md"
check_link "$HOME/.gemini/GEMINI.md" "$DOTFILES_DIR/agents/AGENTS.md"
check_link "$HOME/.claude/CLAUDE.md" "$DOTFILES_DIR/agents/claude/CLAUDE.md"
check_link "$HOME/.codex/hooks.json" "$DOTFILES_DIR/agents/codex/hooks.json"
check_link "$HOME/.gemini/config/hooks.json" "$DOTFILES_DIR/agents/gemini/hooks.json"
check_link "$HOME/.config/ai-tools/models.json" "$DOTFILES_DIR/agents/models.json"

echo "== Tools =="
for tool in git nvim tmux eza bat fzf fd rg gh zoxide lazygit jq yt-dlp alerter python3; do
  if command -v "$tool" >/dev/null 2>&1; then
    ok "tool: $tool"
  else
    bad "tool missing: $tool (brew bundle --file $DOTFILES_DIR/Brewfile)"
  fi
done
command -v ollama >/dev/null 2>&1 && ok "tool: ollama" || warn "tool missing: ollama (optional local model; models.json references it)"

echo "== Agent CLIs =="
for cli in codex agy claude; do
  command -v "$cli" >/dev/null 2>&1 && ok "cli: $cli" || bad "cli missing: $cli"
done
for profile in google naver; do
  auth="$HOME/.codex-accounts/$profile/auth.json"
  if [ -f "$auth" ]; then
    mode="$(stat -f '%Lp' "$auth" 2>/dev/null || stat -c '%a' "$auth" 2>/dev/null)"
    if [ "$mode" = "600" ]; then
      ok "codex auth: $profile"
    else
      bad "codex auth permissions: $auth is mode $mode (expected 600)"
    fi
  else
    warn "codex auth missing: run '${profile:0:1}codex login' once on this machine"
  fi
done
if security find-generic-password -s gemini -a antigravity >/dev/null 2>&1; then
  ok "agy auth: macOS Keychain session"
else
  warn "agy auth missing: run 'agy' once and log in"
fi
if [ -f "$HOME/.claude/settings.json" ] && grep -q "claude-hook" "$HOME/.claude/settings.json" 2>/dev/null; then
  ok "claude hooks configured"
else
  bad "claude hooks not configured: run install.sh"
fi

echo "== Codex policy =="
python3 - "$HOME" <<'PY'
import pathlib
import sys
import tomllib

home = pathlib.Path(sys.argv[1])
expected = {
    "approval_policy": "on-request",
    "sandbox_mode": "danger-full-access",
    "approvals_reviewer": "user",
}
failures = []
for codex_home in (
    home / ".codex",
    home / ".codex-accounts" / "google",
    home / ".codex-accounts" / "naver",
):
    config_path = codex_home / "config.toml"
    try:
        with config_path.open("rb") as file:
            config = tomllib.load(file)
    except (OSError, tomllib.TOMLDecodeError) as error:
        failures.append(f"{config_path}: {error}")
        continue
    for key, value in expected.items():
        if config.get(key) != value:
            failures.append(
                f"{config_path}: {key}={config.get(key)!r} (expected {value!r})"
            )

for failure in failures:
    print(f"CODEX_POLICY {failure}")
if failures:
    sys.exit(1)
print("default, Google, and Naver Codex homes use the Agent OS permission policy")
PY
case $? in
  0) ok "codex permission policy active" ;;
  *) bad "codex permission policy drift (update the local config or D-002)" ;;
esac

echo "== Codex hooks =="
python3 - "$HOME" <<'PY'
import json
import pathlib
import re
import sys
import tomllib

home = pathlib.Path(sys.argv[1])
codex_homes = [
    home / ".codex",
    home / ".codex-accounts" / "google",
    home / ".codex-accounts" / "naver",
]
failures = []
checked = 0


def event_key(name):
    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).lower()


for codex_home in codex_homes:
    config_path = codex_home / "config.toml"
    hooks_path = codex_home / "hooks.json"
    if not config_path.is_file():
        failures.append(f"missing config: {config_path}")
        continue
    if not hooks_path.is_file():
        failures.append(f"missing hooks: {hooks_path}")
        continue

    with config_path.open("rb") as file:
        config = tomllib.load(file)
    hooks = json.loads(hooks_path.read_text(encoding="utf-8"))["hooks"]

    if config.get("features", {}).get("hooks") is False:
        failures.append(f"hooks feature disabled: {config_path}")

    state = config.get("hooks", {}).get("state", {})
    for event, groups in hooks.items():
        for group_index, group in enumerate(groups):
            for hook_index, _hook in enumerate(group.get("hooks", [])):
                checked += 1
                state_key = (
                    f"{hooks_path}:{event_key(event)}:{group_index}:{hook_index}"
                )
                hook_state = state.get(state_key)
                if not isinstance(hook_state, dict) or not hook_state.get("trusted_hash"):
                    failures.append(f"hook not trusted: {state_key}")
                elif hook_state.get("enabled") is False:
                    failures.append(f"hook disabled: {state_key}")

if failures:
    for failure in failures:
        print(f"HOOK {failure}")
    sys.exit(1)
print(f"{checked} trusted and enabled handlers across {len(codex_homes)} Codex homes")
PY
case $? in
  0) ok "codex hooks active" ;;
  *) bad "codex hooks inactive (review HOOK lines; open the Codex hook browser to trust or enable)" ;;
esac

# trusted_hash 존재 여부만으로는 hooks.json 변경 뒤의 오래된 해시를 잡지 못한다.
# Codex가 계산한 실제 신뢰 상태를 hooks/list로 다시 확인한다.
python3 - "$HOME" "$DOTFILES_DIR" <<'PY'
import json
import os
import pathlib
import re
import select
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib

home = pathlib.Path(sys.argv[1])
root = pathlib.Path(sys.argv[2])
codex_homes = [
    home / ".codex",
    home / ".codex-accounts" / "google",
    home / ".codex-accounts" / "naver",
]
failures = []
warnings = []
checked = 0


def event_name(name):
    words = re.findall(r"[A-Z][a-z0-9]*", name)
    return words[0].lower() + "".join(words[1:])


def state_event_name(name):
    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).lower()


def send_request(process, message, timeout=10):
    request_id = message["id"]
    process.stdin.write(json.dumps(message) + "\n")
    process.stdin.flush()
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError(f"request {request_id} timed out")
        ready, _, _ = select.select([process.stdout], [], [], remaining)
        if not ready:
            raise TimeoutError(f"request {request_id} timed out")
        line = process.stdout.readline()
        if not line:
            raise RuntimeError(f"app-server exited before response {request_id}")
        try:
            response = json.loads(line)
        except json.JSONDecodeError:
            continue
        if response.get("id") == request_id:
            return response

for codex_home in codex_homes:
    config_path = codex_home / "config.toml"
    hooks_path = codex_home / "hooks.json"
    try:
        configured = json.loads(hooks_path.read_text(encoding="utf-8"))["hooks"]
        with config_path.open("rb") as file:
            state = tomllib.load(file).get("hooks", {}).get("state", {})
    except (OSError, KeyError, json.JSONDecodeError, tomllib.TOMLDecodeError) as error:
        failures.append(f"{codex_home.name}: cannot read hook config: {error}")
        continue

    expected = []
    for event, groups in configured.items():
        for group_index, group in enumerate(groups):
            for hook_index, hook in enumerate(group.get("hooks", [])):
                expected.append(
                    (
                        event_name(event),
                        hook.get("command"),
                        state_event_name(event),
                        group_index,
                        hook_index,
                    )
                )

    # app-server는 시작하면서 SQLite와 캐시를 쓴다. 실제 Codex 홈을 건드리지
    # 않도록 훅 정의와 신뢰 상태만 임시 홈에 복제해 currentHash를 계산한다.
    temp_home = None
    process = None
    response = None
    detail = ""
    try:
        temp_home = pathlib.Path(
            tempfile.mkdtemp(prefix="dotfiles-doctor-codex-")
        ).resolve()
        temp_hooks = temp_home / "hooks.json"
        temp_hooks.write_text(hooks_path.read_text(encoding="utf-8"), encoding="utf-8")
        config_lines = ["[features]", "hooks = true", ""]
        for _event, _command, state_event, group_index, hook_index in expected:
            real_key = f"{hooks_path}:{state_event}:{group_index}:{hook_index}"
            temp_key = f"{temp_hooks}:{state_event}:{group_index}:{hook_index}"
            hook_state = state.get(real_key, {})
            if not isinstance(hook_state, dict):
                continue
            config_lines.append(f"[hooks.state.{json.dumps(temp_key)}]")
            trusted_hash = hook_state.get("trusted_hash")
            if isinstance(trusted_hash, str):
                config_lines.append(f"trusted_hash = {json.dumps(trusted_hash)}")
            if hook_state.get("enabled") is False:
                config_lines.append("enabled = false")
            config_lines.append("")
        (temp_home / "config.toml").write_text(
            "\n".join(config_lines), encoding="utf-8"
        )

        env = os.environ.copy()
        env["CODEX_HOME"] = str(temp_home)
        env["CODEX_SQLITE_HOME"] = str(temp_home)
        process = subprocess.Popen(
            ["codex", "app-server", "--stdio"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=env,
        )
        initialized = send_request(
            process,
            {
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {"name": "dotfiles-doctor", "version": "1.0"},
                    "capabilities": {"experimentalApi": True},
                },
            },
        )
        if "result" not in initialized:
            raise RuntimeError(f"initialize failed: {initialized.get('error', initialized)}")
        response = send_request(
            process,
            {"id": 2, "method": "hooks/list", "params": {"cwds": [str(root)]}},
        )
    except (OSError, RuntimeError, TimeoutError) as error:
        warnings.append(f"{codex_home.name}: hooks/list unavailable: {error}")
        try:
            detail = process.stderr.read().strip() if process and process.poll() is not None else ""
        except OSError:
            pass
    finally:
        if process is not None:
            if process.stdin:
                process.stdin.close()
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                process.terminate()
                try:
                    process.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
        if temp_home is not None:
            shutil.rmtree(temp_home, ignore_errors=True)

    if not response or "result" not in response:
        if response:
            warnings.append(
                f"{codex_home.name}: hooks/list returned {response.get('error', response)}"
            )
        elif detail:
            warnings.append(f"{codex_home.name}: hooks/list stderr: {detail.splitlines()[-1]}")
        continue

    entries = response["result"].get("data", [])
    entry = next((item for item in entries if item.get("cwd") == str(root)), None)
    if entry is None:
        failures.append(f"{codex_home.name}: hooks/list omitted {root}")
        continue

    for error in entry.get("errors", []):
        failures.append(
            f"{codex_home.name}: {error.get('path', 'hook')}: {error.get('message', 'error')}"
        )
    for warning in entry.get("warnings", []):
        warnings.append(f"{codex_home.name}: {warning}")

    runtime_hooks = entry.get("hooks", [])
    for event, command, _state_event, _group_index, _hook_index in expected:
        matches = [
            hook
            for hook in runtime_hooks
            if hook.get("source") == "user"
            and hook.get("eventName") == event
            and hook.get("command") == command
        ]
        if len(matches) != 1:
            failures.append(
                f"{codex_home.name}: expected one {event} handler for {command!r}, got {len(matches)}"
            )
            continue
        checked += 1
        hook = matches[0]
        if not hook.get("enabled"):
            failures.append(f"{codex_home.name}: disabled {event} handler: {command}")
        if hook.get("trustStatus") not in {"trusted", "managed"}:
            failures.append(
                f"{codex_home.name}: {hook.get('trustStatus')} {event} handler: {command}"
            )

for failure in failures:
    print(f"HOOK_RUNTIME {failure}")
for warning in warnings:
    print(f"HOOK_RUNTIME {warning}")

if failures:
    sys.exit(1)
if warnings:
    sys.exit(2)
print(f"{checked} handlers trusted and enabled in Codex runtime")
PY
case $? in
  0) ok "codex hook runtime active" ;;
  1) bad "codex hook runtime inactive (review HOOK_RUNTIME lines; open the Codex hook browser)" ;;
  *) warn "codex hook runtime status unavailable (static hook check still passed)" ;;
esac

echo "== LaunchAgents =="
# personal-ops-weekly는 은퇴(2026-07-22, session-harvest-weekly로 대체). install.sh가 bootout함
# install.sh 가 reload_agent 로 올리는 잡 전체와 일치시킨다. 목록이 부분집합이면
# 안 올라온 잡을 doctor 가 통과시킨다. agent-notify-menu 가 그렇게 새어나갔다.
for label in com.miniminjae.agent-notify-sweep com.miniminjae.agent-notify-menu \
             com.miniminjae.agent-os-vault-snapshot com.miniminjae.codex-account-usage \
             com.miniminjae.personal-ops-security com.miniminjae.session-harvest-daily \
             com.miniminjae.session-harvest-weekly com.miniminjae.ops-digest-daily \
             com.miniminjae.simulator-reaper com.miniminjae.mirror-to-imac \
             com.miniminjae.mirror-from-imac; do
  if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    ok "launchd: $label"
  else
    warn "launchd not loaded: $label (run install.sh)"
  fi
done

echo "== Scripts contract (D-012) =="
paths_env="$DOTFILES_DIR/agent-os/paths.env"
if [ -r "$paths_env" ] && ! grep -qvE '^(#|$|[A-Z_]+=)' "$paths_env"; then
  ok "paths.env parseable"
else
  bad "paths.env missing or malformed: $paths_env"
fi
registry_diff="$(comm -3 \
  <(ls "$DOTFILES_DIR/bin" | grep -v '^__pycache__$' | sort) \
  <(grep -oE '^\| `[a-z0-9-]+`' "$DOTFILES_DIR/agent-os/scripts.md" 2>/dev/null | tr -d '`| ' | sort))"
if [ -z "$registry_diff" ]; then
  ok "scripts registry matches bin directory ($(ls "$DOTFILES_DIR/bin" | grep -cv '^__pycache__$') scripts)"
else
  bad "scripts registry drift (agent-os/scripts.md vs bin/): $(echo "$registry_diff" | tr '\n' ' ')"
fi
# 하드코딩 vault 경로: 계약(paths.env) 미채택 파일 수. D-012 목표는 단조 감소
uncontracted="$(grep -rlE --exclude-dir=__pycache__ 'obsidian/(mimir|yggdrasil)' "$DOTFILES_DIR/bin" 2>/dev/null |
  xargs grep -L 'paths\.env' 2>/dev/null | wc -l | tr -d ' ')"
if [ "$uncontracted" = 0 ]; then
  ok "hardcoded vault paths: none outside contract"
else
  warn "hardcoded vault paths in $uncontracted file(s) without paths.env contract (D-012: 손댈 때 이관)"
fi

echo "== Layout invariant (D-014) =="
# agents/=설비 세팅값(전부 설치), agent-os/=운전 일지(홈 링크 0). 위반은 구조 부패 신호.
if grep -q 'DOTFILES_DIR/agent-os/' "$DOTFILES_DIR/install.sh"; then
  bad "D-014 invariant broken: install.sh links agent-os/* into home (agent-os must stay uninstalled)"
else
  ok "D-014 invariant: agent-os has zero home links"
fi

echo "== Registry drift =="
python3 - "$DOTFILES_DIR" <<'PY'
import json, pathlib, re, sys

root = pathlib.Path(sys.argv[1])
failures = []
routing = json.loads((root / "agents" / "routing.json").read_text())
routing_models = {entry["model"] for entry in routing["models"].values()}

# Codex agent TOMLs must use models declared in routing.json.
for toml_path in sorted((root / "agents" / "codex" / "agents").glob("*.toml")):
    match = re.search(r'^model\s*=\s*"([^"]+)"', toml_path.read_text(), re.MULTILINE)
    if match and match.group(1) not in routing_models:
        failures.append(f"{toml_path.name}: model '{match.group(1)}' not in routing.json")

# models.json (script-facing registry) must agree with routing.json.
legacy = json.loads((root / "agents" / "models.json").read_text())
for ref, name in legacy.get("models", {}).items():
    if ref in ("agy_gemini_fast", "ollama_local") and name not in routing_models:
        failures.append(f"models.json {ref}: '{name}' not in routing.json")

if failures:
    for failure in failures:
        print(f"DRIFT {failure}")
    sys.exit(1)
print("registries consistent")
PY
case $? in
  0) ok "registry drift: none" ;;
  *) bad "registry drift detected (see DRIFT lines above)" ;;
esac

echo
printf 'summary: %d pass, %d warn, %d fail\n' "$PASS" "$WARN" "$FAIL"
[ "$FAIL" -gt 125 ] && exit 125
exit "$FAIL"
