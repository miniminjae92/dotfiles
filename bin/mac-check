#!/usr/bin/env python3
"""Read-only macOS resource inspection. Only --save writes new local reports."""

import argparse
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
import json
import os
from pathlib import Path
import platform
import plistlib
import re
import subprocess
import sys
import uuid


HOME = Path.home()
REPORTS = HOME / ".local/state/mac-check/reports"
GIB = 1024 ** 3
TARGETS = (
    ("Documents", "문서 폴더", "유일한 원본인지 확인"),
    ("Downloads", "다운로드", "재다운로드 가능 여부 확인"),
    ("Desktop", "데스크탑", "유일한 원본인지 확인"),
    ("projects", "프로젝트", "소스와 생성 결과가 섞여 있음"),
    ("Library/Caches", "앱 캐시", "앱별로 재생성 여부와 비용 확인"),
    ("Library/Application Support", "앱 지원 데이터", "실제 작업 데이터가 있을 수 있음"),
    ("Library/Developer/Xcode/DerivedData", "Xcode 중간 빌드 자료", "재빌드 비용이 발생, 별도 보관한 자료 확인"),
    ("Library/Developer/Xcode/Archives", "Xcode 배포 아카이브", "배포본과 오류 분석 자료 보관 여부 확인"),
    ("Library/Developer/CoreSimulator/Devices", "시뮬레이터 기기 데이터", "기기는 재생성 가능, 내부 앱 데이터는 별도 보존 필요"),
)


def command(args, timeout=15):
    try:
        result = subprocess.run(args, capture_output=True, text=True,
                                timeout=timeout, env={**os.environ, "LC_ALL": "C"})
        return result.stdout, result.stderr.strip(), result.returncode
    except subprocess.TimeoutExpired:
        return "", f"시간 제한 {timeout}초 초과", -1
    except OSError as error:
        return "", str(error), -1


def size(value):
    return "미확인" if value is None else f"{value / GIB:.2f} GiB"


def scan(target):
    relative, label, meaning = target
    path = HOME / relative
    row = dict(path=str(path), label=label, meaning=meaning,
               bytes=None, status="unknown", children=[])
    try:
        path.stat()
    except FileNotFoundError:
        row["status"] = "missing"
        return row
    except OSError as error:
        row["error"] = str(error)
        return row
    print(f"점검: ~/{relative}", file=sys.stderr, flush=True)
    output, error, code = command(["/usr/bin/du", "-k", "-d", "1", str(path)], 120)
    for line in output.splitlines():
        fields = line.split("\t", 1)
        if len(fields) != 2 or not fields[0].isdigit():
            continue
        count, name = int(fields[0]) * 1024, fields[1]
        if name == str(path):
            row["bytes"] = count
        else:
            row["children"].append(dict(path=name, bytes=count))
    row["children"].sort(key=lambda child: child["bytes"], reverse=True)
    row["status"] = "complete" if code == 0 and row["bytes"] is not None else "partial"
    if error or row["status"] != "complete":
        row["error"] = (error or "용량 합계를 읽지 못함")[:1500]
    if relative.endswith("CoreSimulator/Devices"):
        for child in row["children"]:
            try:
                with (Path(child["path"]) / "device.plist").open("rb") as stream:
                    metadata = plistlib.load(stream)
                child["name"] = metadata.get("name", Path(child["path"]).name)
                child["state_code"] = metadata.get("state")
            except (OSError, ValueError, plistlib.InvalidFileException):
                pass
    return row


def memory():
    result = {"errors": []}
    for key, args in (
        ("total_bytes", ["/usr/sbin/sysctl", "-n", "hw.memsize"]),
        ("pressure_code", ["/usr/sbin/sysctl", "-n", "kern.memorystatus_vm_pressure_level"]),
    ):
        output, error, code = command(args)
        if code == 0 and output.strip().isdigit():
            result[key] = int(output.strip())
        else:
            result["errors"].append(f"{key}: {error or '값을 읽지 못함'}")
    # sysctl exports dispatch notification flags, not the internal kernel enum.
    # https://github.com/apple-oss-distributions/xnu/blob/main/bsd/kern/kern_memorystatus_notify.c
    result["pressure"] = {1: "정상", 2: "주의", 4: "위험"}.get(result.get("pressure_code"), "미확인")
    output, error, code = command(["/usr/sbin/sysctl", "vm.swapusage"])
    match = re.search(r"used\s*=\s*([\d.]+)([KMGT])", output)
    if code == 0 and match:
        result["swap_used_bytes"] = int(float(match[1]) * 1024 ** ("KMGT".index(match[2]) + 1))
    else:
        result["errors"].append(f"swap: {error or '값을 읽지 못함'}")
    output, error, code = command(["/usr/bin/vm_stat"])
    page = re.search(r"page size of (\d+) bytes", output)
    compressed = re.search(r"Pages occupied by compressor:\s+(\d+)", output)
    if code == 0 and page and compressed:
        result["compressed_bytes"] = int(page[1]) * int(compressed[1])
    else:
        result["errors"].append(f"vm_stat: {error or '값을 읽지 못함'}")
    # comm excludes arguments that could contain credentials.
    output, error, code = command(["/bin/ps", "-axo", "pid=,rss=,comm="])
    processes = []
    for line in output.splitlines():
        fields = line.split(None, 2)
        if len(fields) == 3 and fields[0].isdigit() and fields[1].isdigit():
            processes.append(dict(pid=int(fields[0]), rss_bytes=int(fields[1]) * 1024,
                                  name=Path(fields[2]).name))
    result["processes"] = sorted(processes, key=lambda item: item["rss_bytes"], reverse=True)[:10]
    if code:
        result["errors"].append(f"ps: {error or '값을 읽지 못함'}")
    result["sampled_at"] = datetime.now().astimezone().isoformat()
    return result


def disk():
    try:
        info = os.statvfs("/System/Volumes/Data")
        return dict(total_bytes=info.f_blocks * info.f_frsize,
                    available_bytes=info.f_bavail * info.f_frsize,
                    used_bytes=(info.f_blocks - info.f_bfree) * info.f_frsize)
    except OSError as error:
        return {"error": str(error)}


def previous_report(require_folders=False):
    for path in sorted(REPORTS.glob("*.json"), reverse=True):
        try:
            saved = json.loads(path.read_text())
            if (saved.get("schema") == 1 and saved.get("host") == platform.node()
                    and saved.get("home") == str(HOME)
                    and (not require_folders or saved.get("folders"))):
                return saved
        except (OSError, ValueError, AttributeError):
            continue
    return None


def changes(report, previous):
    if not previous:
        return []
    old = {row["path"]: row for row in previous.get("folders", [])}
    result = []
    for row in report["folders"]:
        before = old.get(row["path"], {})
        if (row["status"] == before.get("status") == "complete"
                and before.get("bytes") is not None):
            result.append(dict(label=row["label"], bytes=row["bytes"] - before["bytes"]))
    return sorted(result, key=lambda item: abs(item["bytes"]), reverse=True)


def cell(value):
    return str(value).replace("|", "\\|").replace("\n", " ").replace("\r", " ")


def markdown(report):
    mem, drive = report["memory"], report["disk"]
    lines = ["# Mac 점검", "", f"수집 시작: {report['started_at']}",
             f"RAM 측정: {mem['sampled_at']}", f"수집 종료: {report['finished_at']}", "",
             "## 지금 상태", "",
             f"- 저장 공간: 전체 {size(drive.get('total_bytes'))}, 사용 가능 {size(drive.get('available_bytes'))}",
             f"- RAM: 설치 {size(mem.get('total_bytes'))}, 메모리 압박 {mem['pressure']} (코드 {mem.get('pressure_code', '미확인')})",
             f"- 압축된 메모리가 차지하는 RAM: {size(mem.get('compressed_bytes'))}",
             f"- 스왑 사용: {size(mem.get('swap_used_bytes'))}", "",
             "RAM은 실행 중인 작업 공간입니다. 메모리 압박은 macOS가 작업에 필요한 RAM을 마련하는 부담입니다.",
             "스왑은 메모리 일부를 SSD에 옮겨 둔 공간입니다. 스왑이 있다는 사실만으로 현재 부족하다고 판단하지 않습니다."]
    if mem["pressure"] == "정상":
        lines.append("이번 측정의 메모리 압박은 정상입니다. 사용량 숫자만 낮추려고 앱을 종료할 필요는 없습니다.")
    elif mem["pressure"] in ("주의", "위험"):
        lines.append("메모리 압박이 있습니다. 아래 앱과 현재 작업을 확인하고, 저장 후 불필요한 작업 종료를 검토합니다.")
    else:
        lines.append("압박 상태를 읽지 못했습니다. 활성 상태 보기의 메모리 탭에서 확인합니다.")
    lines += ["", "## 저장 공간", "",
              "GiB는 1024³바이트입니다. macOS 설정의 GB 표기와 차이가 날 수 있습니다.",
              "선택한 폴더의 디스크 할당량을 읽습니다. 시스템 전체 조사나 Documents/System Data 분류 재현이 아닙니다.",
              "공유 APFS 블록, 스냅샷, 접근 권한 때문에 폴더 합계와 실제 확보 가능한 공간은 다릅니다.", ""]
    if not report["folders"]:
        lines.append("빠른 점검으로 폴더 검사를 생략했습니다. 전체 점검은 `mac-check`를 실행합니다.")
    else:
        lines += ["| 항목 | 용량 | 측정 | 판단에 필요한 확인 |", "|---|---:|---|---|"]
        for row in sorted(report["folders"], key=lambda item: item["bytes"] or 0, reverse=True):
            state = {"complete": "완료", "partial": "일부 누락", "unknown": "미확인", "missing": "경로 없음"}[row["status"]]
            lines.append(f"| {row['label']} | {size(row['bytes'])} | {state} | {row['meaning']} |")
        for row in report["folders"]:
            lines += ["", f"### {row['label']}", "", f"경로: {cell(row['path'])}"]
            for child in row["children"][:6]:
                name = child.get("name", Path(child["path"]).name)
                lines.append(f"- {cell(name)}: {size(child['bytes'])}")
            if row.get("error"):
                lines.append(f"- 누락 사유: {cell(row['error'])}")
    lines += ["", "## RAM을 많이 점유한 프로세스", "",
              "RSS는 현재 RAM에 올라온 양입니다. 공유 메모리가 포함되므로 합산하거나 활성 상태 보기의 메모리 값과 동일시하지 않습니다.",
              "프로세스 하나씩 표시합니다. 브라우저처럼 여러 프로세스로 나뉜 앱의 총량은 아닙니다.", "",
              "| 프로세스 | PID | RSS |", "|---|---:|---:|"]
    for item in mem["processes"]:
        lines.append(f"| {cell(item['name'])} | {item['pid']} | {size(item['rss_bytes'])} |")
    lines += ["", "## 이전 저장 결과와 비교", ""]
    if report["previous_at"]:
        lines.append(f"이전 수집 시작: {report['previous_at']}. 양쪽 모두 측정 완료한 같은 폴더만 비교합니다.")
        for item in report["changes"]:
            lines.append(f"- {item['label']}: {item['bytes'] / GIB:+.2f} GiB")
        if not report["changes"]:
            lines.append("비교 가능한 폴더가 없습니다.")
    else:
        lines.append("이전 저장 결과가 없습니다. `mac-check --save`로 기준을 남길 수 있습니다.")
    errors = mem["errors"] + ([drive["error"]] if drive.get("error") else [])
    if errors:
        lines += ["", "## 읽지 못한 값", ""] + [f"- {cell(error)}" for error in errors]
    lines += ["", "## 다음 대화", "",
              "이 결과를 바탕으로 '가장 큰 항목부터 설명해줘', '지난번보다 늘어난 이유를 확인해줘'라고 요청할 수 있습니다.",
              "삭제, 앱 종료, 캐시 초기화는 하지 않았습니다. 정리 후보는 보관 필요성과 복구 방법을 확인한 뒤 결정합니다.",
              "보관 이유는 이 보고서에 자동 저장되지 않습니다. 확정한 판단은 별도 관리 기록으로 남깁니다.", "",
              "참고: [Apple 저장 공간 분류](https://support.apple.com/guide/mac-help/find-and-delete-files-on-your-mac-syspf5a64aa6/mac),",
              "[배포 아카이브 보관](https://developer.apple.com/documentation/xcode/building-your-app-to-include-debugging-information),",
              "[메모리 압박 값의 변환](https://github.com/apple-oss-distributions/xnu/blob/main/bsd/kern/kern_memorystatus_notify.c)", ""]
    return "\n".join(lines)


def save(report, rendered):
    REPORTS.mkdir(parents=True, exist_ok=True, mode=0o700)
    stem = datetime.now().strftime("%Y%m%d-%H%M%S-%f") + "-" + uuid.uuid4().hex[:8]
    for suffix, content in (("json", json.dumps(report, ensure_ascii=False, indent=2) + "\n"),
                            ("md", rendered)):
        path = REPORTS / f"{stem}.{suffix}"
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "w") as stream:
            stream.write(content)
        print(f"저장: {path}", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description="Mac 저장 공간과 RAM을 읽기 전용으로 점검합니다. Python 3, macOS 필요.",
                                     epilog="폴더별 최대 120초, 동시 3개 검사. --save 이외에는 파일을 쓰지 않습니다.")
    parser.add_argument("--quick", action="store_true", help="폴더 용량 검사 생략, RAM과 전체 디스크만 확인")
    parser.add_argument("--json", action="store_true", help="에이전트가 읽을 JSON 출력")
    parser.add_argument("--save", action="store_true", help=f"새 Markdown/JSON 보고서 저장: {REPORTS}")
    args = parser.parse_args()
    if sys.platform != "darwin":
        parser.error("macOS 전용 도구입니다.")
    report = dict(schema=1, host=platform.node(), home=str(HOME),
                  started_at=datetime.now().astimezone().isoformat())
    report["memory"], report["disk"] = memory(), disk()
    report["folders"] = []
    if not args.quick:
        with ThreadPoolExecutor(max_workers=3) as pool:
            report["folders"] = list(pool.map(scan, TARGETS))
    previous = previous_report(require_folders=not args.quick)
    report["previous_at"] = previous["started_at"] if previous else None
    report["changes"] = changes(report, previous)
    report["finished_at"] = datetime.now().astimezone().isoformat()
    rendered = markdown(report)
    if args.save:
        save(report, rendered)
    print(json.dumps(report, ensure_ascii=False, indent=2) if args.json else rendered)


if __name__ == "__main__":
    main()
