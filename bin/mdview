<script src="/assets/markdown-it-anchor.umd.js"></script>
<script src="/assets/highlight.min.js"></script>
<script>
'use strict';
const $ = (s, el) => (el || document).querySelector(s);
const contentEl = $('#content');
const scrollEl = $('#page-scroll');
const state = { doc: null, mtime: 0, tree: null, rootPath: '', fileRows: new Map(), dirRows: new Map() };

const LS = 'mdview:';
const getLS = (k, d) => { try { const v = localStorage.getItem(LS + k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } };
const setLS = (k, v) => { try { localStorage.setItem(LS + k, JSON.stringify(v)); } catch (e) {} };
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

// ── settings ──────────────────────────────────────────────
const settings = {
	font: getLS('font', 18),
	width: getLS('width', 920),
	theme: getLS('theme', 'auto'),
	side: getLS('side', true),
	sideW: getLS('sideW', 280),
};
const mq = matchMedia('(prefers-color-scheme: dark)');
const effTheme = () => settings.theme === 'auto' ? (mq.matches ? 'dark' : 'light') : settings.theme;

function applyTheme() {
	document.documentElement.dataset.theme = effTheme();
	$('#btn-theme').textContent = settings.theme === 'auto' ? '◐ 자동' : (settings.theme === 'light' ? '☀ 밝게' : '☾ 어둡게');
	restyleMermaid();
}
function applyFont() {
	settings.font = Math.min(26, Math.max(13, settings.font));
	document.documentElement.style.setProperty('--reader-font-size', settings.font + 'px');
	$('#font-val').textContent = settings.font + 'px';
}
function applyWidth() {
	document.documentElement.style.setProperty('--reader-measure', settings.width + 'px');
	$('#width-range').value = settings.width;
	$('#width-val').textContent = settings.width >= 1600 ? '최대' : settings.width + 'px';
}
function applySide() {
	document.body.classList.toggle('side-closed', !settings.side);
	document.documentElement.style.setProperty('--sidebar-w', settings.sideW + 'px');
}

mq.addEventListener('change', () => { if (settings.theme === 'auto') applyTheme(); });
$('#font-dn').addEventListener('click', () => { settings.font -= 1; applyFont(); setLS('font', settings.font); });
$('#font-up').addEventListener('click', () => { settings.font += 1; applyFont(); setLS('font', settings.font); });
$('#width-range').addEventListener('input', e => { settings.width = +e.target.value; applyWidth(); setLS('width', settings.width); });
$('#btn-theme').addEventListener('click', () => {
	settings.theme = settings.theme === 'auto' ? 'light' : (settings.theme === 'light' ? 'dark' : 'auto');
	applyTheme(); setLS('theme', settings.theme);
});
$('#btn-side').addEventListener('click', () => { settings.side = !settings.side; applySide(); setLS('side', settings.side); });
document.addEventListener('keydown', e => {
	if (e.key === 'b' && !e.metaKey && !e.ctrlKey && !e.altKey && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) {
		settings.side = !settings.side; applySide(); setLS('side', settings.side);
	}
});

// sidebar drag-resize
(() => {
	const rz = $('#resizer');
	let dragging = false;
	rz.addEventListener('mousedown', e => { dragging = true; e.preventDefault(); document.body.style.cursor = 'col-resize'; });
	window.addEventListener('mousemove', e => {
		if (!dragging) return;
		settings.sideW = Math.min(520, Math.max(180, e.clientX));
		document.documentElement.style.setProperty('--sidebar-w', settings.sideW + 'px');
	});
	window.addEventListener('mouseup', () => {
		if (!dragging) return;
		dragging = false; document.body.style.cursor = ''; setLS('sideW', settings.sideW);
	});
})();

// ── mermaid (lazy) ────────────────────────────────────────
let mermaidReady = null, mmSeq = 0;
function initMermaid() {
	if (window.mermaid) mermaid.initialize({ startOnLoad: false, theme: effTheme() === 'dark' ? 'dark' : 'neutral', securityLevel: 'strict' });
}
function loadMermaid() {
	if (!mermaidReady) {
		mermaidReady = new Promise((res, rej) => {
			const s = document.createElement('script');
			s.src = '/assets/mermaid.min.js';
			s.onload = () => { initMermaid(); res(); };
			s.onerror = () => rej(new Error('mermaid asset missing'));
			document.head.appendChild(s);
		});
	}
	return mermaidReady;
}
async function drawMermaid(wrap) {
	try {
		const r = await mermaid.render('mm' + (++mmSeq), wrap.dataset.src);
		wrap.innerHTML = r.svg;
	} catch (e) {
		wrap.innerHTML = '<pre class="mermaid-error"><code></code></pre>';
		wrap.querySelector('code').textContent = wrap.dataset.src;
	}
}
async function renderMermaidIn(container) {
	const blocks = Array.from(container.querySelectorAll('pre.mermaid-block'));
	if (!blocks.length) return;
	try { await loadMermaid(); } catch (e) { return; }
	for (const b of blocks) {
		const wrap = document.createElement('div');
		wrap.className = 'mermaid-wrap';
		wrap.dataset.src = b.textContent.replace(/\n$/, '');
		b.replaceWith(wrap);
		drawMermaid(wrap);
	}
}
function restyleMermaid() {
	if (!window.mermaid) return;
	initMermaid();
	document.querySelectorAll('.mermaid-wrap').forEach(drawMermaid);
}

// ── markdown-it ───────────────────────────────────────────
function highlightFn(str, lang) {
	const l = (lang || '').trim().toLowerCase();
	if (l === 'mermaid') return '<pre class="mermaid-block"><code>' + esc(str) + '</code></pre>';
	if (window.hljs && l && hljs.getLanguage(l)) {
		try { return '<pre class="hljs"><code>' + hljs.highlight(str, { language: l, ignoreIllegals: true }).value + '</code></pre>'; } catch (e) {}
	}
	return '';
}

function resolveRel(href, baseDir) {
	if (!href) return null;
	const hashIdx = href.indexOf('#');
	const rawPath = hashIdx === -1 ? href : href.slice(0, hashIdx);
	const hash = hashIdx === -1 ? '' : href.slice(hashIdx);
	if (!rawPath) return null;
	const segs = rawPath.startsWith('/') ? [] : (baseDir ? baseDir.split('/') : []);
	for (const p0 of rawPath.split('/')) {
		let p = p0;
		try { p = decodeURIComponent(p0); } catch (e) {}
		if (p === '' || p === '.') continue;
		if (p === '..') { if (!segs.length) return null; segs.pop(); continue; }
		segs.push(p);
	}
	if (!segs.length) return null;
	const path = segs.join('/');
	return { path, hash, isMd: /\.(md|markdown|mdx)$/i.test(path) };
}
const rawUrl = p => '/raw/' + p.split('/').map(encodeURIComponent).join('/');

let md = null;
if (window.markdownit) {
	md = window.markdownit({ html: true, linkify: true, highlight: highlightFn });
	if (window.markdownitTaskLists) md.use(window.markdownitTaskLists);
	if (window.markdownItAnchor) {
		md.use(window.markdownItAnchor, {
			permalink: window.markdownItAnchor.permalink.linkInsideHeader({ class: 'anchor', symbol: '#', placement: 'before', ariaHidden: true }),
		});
	}
	const defImage = md.renderer.rules.image;
	md.renderer.rules.image = (tokens, idx, options, env, self) => {
		const t = tokens[idx];
		const src = t.attrGet('src') || '';
		if (!/^[a-z][a-z0-9+.-]*:/i.test(src) && !src.startsWith('//') && !src.startsWith('data:')) {
			const r = resolveRel(src, env.docDir);
			if (r) t.attrSet('src', rawUrl(r.path));
		}
		return defImage(tokens, idx, options, env, self);
	};
	const defLink = md.renderer.rules.link_open || ((t, i, o, e, s) => s.renderToken(t, i, o));
	md.renderer.rules.link_open = (tokens, idx, options, env, self) => {
		const t = tokens[idx];
		const href = t.attrGet('href') || '';
		if (/^[a-z][a-z0-9+.-]*:/i.test(href) || href.startsWith('//')) {
			t.attrSet('target', '_blank');
			t.attrSet('rel', 'noopener');
		} else if (href && !href.startsWith('#')) {
			const r = resolveRel(href, env.docDir);
			if (r && r.isMd) {
				t.attrSet('href', '?doc=' + encodeURIComponent(r.path) + r.hash);
				t.attrSet('data-doc', r.path);
				if (r.hash) t.attrSet('data-hash', r.hash);
			} else if (r) {
				t.attrSet('href', rawUrl(r.path));
			}
		}
		return defLink(tokens, idx, options, env, self);
	};
} else {
	$('#asset-warn').style.display = 'block';
}

// ── document loading ──────────────────────────────────────
function renderDoc(text, path) {
	if (!md) {
		contentEl.innerHTML = '<pre></pre>';
		contentEl.querySelector('pre').textContent = text;
		return;
	}
	const docDir = path.includes('/') ? path.slice(0, path.lastIndexOf('/')) : '';
	contentEl.innerHTML = md.render(text, { docDir });
	renderMermaidIn(contentEl);
}

function scrollToHash(hash) {
	if (!hash) { scrollEl.scrollTop = 0; return; }
	const raw = hash.slice(1);
	let el = document.getElementById(raw);
	if (!el) { try { el = document.getElementById(decodeURIComponent(raw)); } catch (e) {} }
	// markdown-it-anchor는 소문자화 후 인코딩한다 — 같은 순서로 맞춰야 한글 앵커가 일치한다
	if (!el) { try { el = document.getElementById(encodeURIComponent(decodeURIComponent(raw).toLowerCase())); } catch (e) {} }
	if (el) el.scrollIntoView(); else scrollEl.scrollTop = 0;
}

async function openDoc(path, opts) {
	const o = opts || {};
	let data;
	try {
		const r = await fetch('/api/file?path=' + encodeURIComponent(path));
		if (!r.ok) throw new Error(r.status);
		data = await r.json();
	} catch (e) {
		contentEl.innerHTML = '<div class="err-card"><h1>문서를 열 수 없습니다</h1><p><code></code></p></div>';
		contentEl.querySelector('code').textContent = path;
		state.doc = null;
		return;
	}
	state.doc = path;
	state.mtime = data.mtime;
	renderDoc(data.content, path);
	$('#crumb').textContent = path.split('/').join('  ›  ');
	document.title = path.split('/').pop() + ' · mdview';
	if (o.push !== false) history.pushState({ doc: path }, '', '?doc=' + encodeURIComponent(path) + (o.hash || ''));
	markActive(path);
	scrollToHash(o.hash || '');
}

function welcome() {
	state.doc = null;
	$('#crumb').textContent = '';
	document.title = (state.tree ? state.tree.root : 'mdview') + ' · mdview';
	const count = state.tree ? state.tree.count : 0;
	contentEl.innerHTML = '<h1 id="wt"></h1><p class="muted">왼쪽 목록에서 문서를 선택하세요 · 문서 ' + count + '개</p>';
	$('#wt').textContent = state.tree ? state.tree.root : 'mdview';
}

// intercept .md links for SPA navigation
contentEl.addEventListener('click', e => {
	const a = e.target.closest('a[data-doc]');
	if (!a) return;
	e.preventDefault();
	openDoc(a.dataset.doc, { hash: a.dataset.hash || '' });
});

// ── file tree ─────────────────────────────────────────────
let expandedSet = new Set();
function persistExpanded() { setLS('expanded:' + state.rootPath, Array.from(expandedSet)); }

function buildDir(node, ul) {
	for (const d of node.dirs) {
		const li = document.createElement('li');
		li.className = 'dir' + (expandedSet.has(d.path) ? '' : ' closed');
		const row = document.createElement('div');
		row.className = 'row';
		row.innerHTML = '<span class="caret">▶</span><span class="name"></span>';
		row.querySelector('.name').textContent = d.name;
		row.addEventListener('click', () => {
			const closed = li.classList.toggle('closed');
			if (closed) expandedSet.delete(d.path); else expandedSet.add(d.path);
			persistExpanded();
		});
		li.appendChild(row);
		state.dirRows.set(d.path, li);
		const sub = document.createElement('ul');
		buildDir(d, sub);
		li.appendChild(sub);
		ul.appendChild(li);
	}
	for (const f of node.files) {
		const li = document.createElement('li');
		const row = document.createElement('div');
		row.className = 'row file';
		const nm = document.createElement('span');
		nm.className = 'name';
		nm.textContent = f.name;
		row.appendChild(nm);
		row.title = f.path;
		row.addEventListener('click', () => openDoc(f.path));
		state.fileRows.set(f.path, row);
		li.appendChild(row);
		ul.appendChild(li);
	}
}

function renderTree() {
	const nav = $('#tree');
	nav.textContent = '';
	state.fileRows.clear();
	state.dirRows.clear();
	const stored = getLS('expanded:' + state.rootPath, null);
	expandedSet = new Set(stored || state.tree.tree.dirs.map(d => d.path));
	const ul = document.createElement('ul');
	buildDir(state.tree.tree, ul);
	nav.appendChild(ul);
	if (state.doc) markActive(state.doc);
	const note = $('#tree-note');
	note.hidden = !state.tree.truncated;
	if (state.tree.truncated) note.textContent = '항목이 많아 일부만 표시했습니다.';
}

function markActive(path) {
	document.querySelectorAll('.row.file.active').forEach(el => el.classList.remove('active'));
	const row = state.fileRows.get(path);
	if (!row) return;
	row.classList.add('active');
	const parts = path.split('/');
	let prefix = '';
	for (let i = 0; i < parts.length - 1; i++) {
		prefix = prefix ? prefix + '/' + parts[i] : parts[i];
		const li = state.dirRows.get(prefix);
		if (li) { li.classList.remove('closed'); expandedSet.add(prefix); }
	}
}

let treeJson = '';
async function loadTree() {
	let raw;
	try {
		const r = await fetch('/api/tree');
		if (!r.ok) return;
		raw = await r.text();
	} catch (e) { return; }
	if (raw === treeJson) return;  // 변화 없으면 사이드바를 건드리지 않는다 (클릭·스크롤 보존)
	treeJson = raw;
	state.tree = JSON.parse(raw);
	state.rootPath = state.tree.rootPath;
	$('#root-name').textContent = state.tree.root;
	$('#root-name').title = state.tree.rootPath;
	$('#doc-count').textContent = state.tree.count + '개';
	const keep = $('#tree').scrollTop;
	renderTree();
	$('#tree').scrollTop = keep;
	if (!state.doc) document.title = state.tree.root + ' · mdview';
}

// filename filter → flat result list
$('#filter').addEventListener('input', e => {
	const q = e.target.value.trim().toLowerCase();
	const res = $('#results');
	if (!q) { res.hidden = true; $('#tree').hidden = false; return; }
	$('#tree').hidden = true;
	res.hidden = false;
	res.textContent = '';
	const ul = document.createElement('ul');
	let n = 0;
	for (const [p] of state.fileRows) {
		if (!p.toLowerCase().includes(q)) continue;
		if (++n > 200) break;
		const li = document.createElement('li');
		const row = document.createElement('div');
		row.className = 'row';
		const nm = document.createElement('span');
		nm.textContent = p.split('/').pop();
		const pt = document.createElement('span');
		pt.className = 'rpath';
		pt.textContent = p;
		row.appendChild(nm);
		row.appendChild(pt);
		row.addEventListener('click', () => openDoc(p));
		li.appendChild(row);
		ul.appendChild(li);
	}
	if (!n) {
		const li = document.createElement('li');
		li.className = 'side-note';
		li.textContent = '일치하는 파일이 없습니다';
		ul.appendChild(li);
	}
	res.appendChild(ul);
});

// ── auto-reload & routing ─────────────────────────────────
async function checkReload() {
	const doc = state.doc;
	if (!doc) return;
	try {
		const r = await fetch('/api/stat?path=' + encodeURIComponent(doc));
		if (!r.ok || state.doc !== doc) return;
		const s = await r.json();
		if (state.doc !== doc || !state.mtime || s.mtime <= state.mtime) return;
		const fr = await fetch('/api/file?path=' + encodeURIComponent(doc));
		if (!fr.ok || state.doc !== doc) return;
		const d = await fr.json();
		if (state.doc !== doc || typeof d.content !== 'string') return;
		state.mtime = d.mtime;
		const keep = scrollEl.scrollTop;
		renderDoc(d.content, doc);
		scrollEl.scrollTop = keep;
	} catch (e) {}
}
setInterval(() => { if (!document.hidden) checkReload(); }, 1500);
document.addEventListener('visibilitychange', () => { if (!document.hidden) checkReload(); });

window.addEventListener('focus', loadTree);

function findReadme() {
	if (!state.tree) return null;
	const files = state.tree.tree.files;
	for (const pat of [/^readme\.(md|markdown|mdx)$/i, /^index\.md$/i]) {
		const hit = files.find(f => pat.test(f.name));
		if (hit) return hit.path;
	}
	return null;
}

function routeFromLocation() {
	const doc = new URLSearchParams(location.search).get('doc');
	// 같은 문서 안의 앵커 이동도 popstate를 쏜다 — 다시 받아오지 말고 스크롤만 옮긴다
	if (doc && doc === state.doc) { scrollToHash(location.hash || ''); return; }
	if (doc) openDoc(doc, { push: false, hash: location.hash || '' });
	else { const rm = findReadme(); if (rm) openDoc(rm, { push: false }); else welcome(); }
}
window.addEventListener('popstate', routeFromLocation);

// ── init ──────────────────────────────────────────────────
applyTheme(); applyFont(); applyWidth(); applySide();
loadTree().then(routeFromLocation);
</script>
</body>
</html>
"""


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="mdview",
        description="디렉터리의 마크다운 문서를 브라우저에서 탐색·열람한다 (nvim <leader>mp 프리뷰의 웹 버전).",
    )
    ap.add_argument("path", nargs="?", default=".", help="서빙할 디렉터리 또는 마크다운 파일 (기본: .)")
    ap.add_argument("-p", "--port", type=int, help=f"포트 (기본: {DEFAULT_PORT}, 사용 중이면 자동 선택)")
    ap.add_argument("--host", default="127.0.0.1", help="바인딩 주소 (기본: 127.0.0.1)")
    ap.add_argument("--no-open", action="store_true", help="브라우저를 자동으로 열지 않는다")
    ap.add_argument("--refresh-assets", action="store_true", help="렌더러 에셋을 다시 내려받는다")
    ap.add_argument("--verbose", action="store_true", help="HTTP 요청 로그를 출력한다")
    ap.add_argument("--version", action="version", version="mdview " + VERSION)
    args = ap.parse_args(argv)

    target = Path(args.path).expanduser()
    try:
        target = target.resolve(strict=True)
    except OSError:
        print(f"mdview: 경로가 없습니다: {args.path}", file=sys.stderr)
        return 1

    initial_doc = None
    if target.is_file():
        if target.suffix.lower() not in MD_EXTS:
            print(f"mdview: 마크다운 파일이 아닙니다: {target.name}", file=sys.stderr)
            return 1
        initial_doc = target.name
        root = target.parent
    elif target.is_dir():
        root = target
    else:
        print(f"mdview: 지원하지 않는 경로입니다: {target}", file=sys.stderr)
        return 1

    ensure_assets(refresh=args.refresh_assets)

    try:
        if args.port:
            httpd = MdViewServer((args.host, args.port), Handler, root, args.verbose)
        else:
            try:
                httpd = MdViewServer((args.host, DEFAULT_PORT), Handler, root, args.verbose)
            except OSError:
                httpd = MdViewServer((args.host, 0), Handler, root, args.verbose)
    except (OSError, OverflowError) as exc:
        print(f"mdview: 서버를 시작할 수 없습니다: {exc}", file=sys.stderr)
        return 1

    if httpd.allowed_hosts is None:
        print(f"mdview: 경고 — {args.host} 로 바인딩했습니다. 같은 네트워크의 누구나 이 문서를 읽을 수 있습니다.", file=sys.stderr)

    port = httpd.server_address[1]
    url = f"http://{args.host}:{port}/"
    if initial_doc:
        url += "?doc=" + quote(initial_doc)

    print(f"mdview · {root}")
    print(f"  → {url}")
    print("  (Ctrl+C 로 종료)")

    if not args.no_open:
        webbrowser.open(url)

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nmdview: 종료합니다.")
    finally:
        httpd.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
