#!/usr/bin/env python3
"""mdview — browse a directory of Markdown files in the browser.

Web counterpart of the nvim <leader>mp preview: same reader stylesheet
(~/.config/nvim/assets/markdown-reader.css palette), plus a file tree,
font-size / theme / content-width controls, and auto-reload on file change.

Usage:
  mdview .                  # serve current directory
  mdview ~/notes            # serve a directory
  mdview README.md          # serve parent dir, open this file
"""

from __future__ import annotations

import argparse
import json
import mimetypes
import os
import shutil
import sys
import threading
import time
import urllib.request
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, quote, unquote, urlparse

VERSION = "1.0.0"
DEFAULT_PORT = 8642
MD_EXTS = {".md", ".markdown", ".mdx"}
IGNORE_DIRS = {"node_modules", "__pycache__", "venv"}
MAX_ENTRIES = 50000
LOOPBACK_HOSTS = {"127.0.0.1", "localhost", "::1", "[::1]"}

ASSET_DIR = Path(os.environ.get("MDVIEW_ASSET_DIR", str(Path.home() / ".cache" / "mdview" / "assets")))
ASSETS = {
    "markdown-it.min.js": "https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js",
    "markdown-it-task-lists.min.js": "https://cdn.jsdelivr.net/npm/markdown-it-task-lists@2.1.1/dist/markdown-it-task-lists.min.js",
    "markdown-it-anchor.umd.js": "https://cdn.jsdelivr.net/npm/markdown-it-anchor@9.2.0/dist/markdownItAnchor.umd.js",
    "highlight.min.js": "https://cdn.jsdelivr.net/npm/@highlightjs/cdn-assets@11.11.1/highlight.min.js",
    "mermaid.min.js": "https://cdn.jsdelivr.net/npm/mermaid@11.9.0/dist/mermaid.min.js",
}


def ensure_assets(refresh: bool = False) -> None:
    try:
        ASSET_DIR.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(f"  ! 에셋 디렉터리를 만들 수 없습니다 ({ASSET_DIR}): {exc}", file=sys.stderr)
        print("  렌더러 없이 원문만 표시됩니다. MDVIEW_ASSET_DIR 로 쓰기 가능한 경로를 지정하세요.", file=sys.stderr)
        return
    missing = []
    for name, url in ASSETS.items():
        dest = ASSET_DIR / name
        if dest.exists() and dest.stat().st_size > 0 and not refresh:
            continue
        try:
            print(f"  에셋 내려받는 중: {name} …", flush=True)
            req = urllib.request.Request(url, headers={"User-Agent": "mdview/" + VERSION})
            with urllib.request.urlopen(req, timeout=60) as resp:
                data = resp.read()
            tmp = dest.with_name(dest.name + ".tmp")
            tmp.write_bytes(data)
            tmp.replace(dest)
        except Exception as exc:  # noqa: BLE001 — 네트워크 실패는 경고로만
            missing.append(name)
            print(f"  ! {name} 다운로드 실패: {exc}", file=sys.stderr)
    if missing:
        print(
            "  일부 렌더러 에셋이 없어 표시가 제한될 수 있습니다."
            " 네트워크 연결 후 `mdview --refresh-assets`를 실행하세요.",
            file=sys.stderr,
        )


def safe_path(root: Path, rel: str) -> Path | None:
    """Resolve a request-relative path lexically.

    Rejects absolute paths, '..', dotfiles, and the ignored directories — the
    served surface stays what the sidebar shows, so a stray script inside a
    rendered document can't read .env / .git / .ssh out of the served root.
    """
    if not rel or rel.startswith("/") or "\x00" in rel:
        return None
    parts = [p for p in rel.split("/") if p not in ("", ".")]
    if not parts:
        return None
    for p in parts:
        if p == ".." or p.startswith(".") or p in IGNORE_DIRS:
            return None
    return root.joinpath(*parts)


def scan_tree(root: Path) -> dict:
    file_count = 0
    visited = 0
    truncated = False

    def walk(d: Path, rel: str, ancestors: frozenset) -> dict | None:
        nonlocal file_count, visited, truncated
        try:
            rp = d.resolve()
        except OSError:
            return None
        if rp in ancestors:  # symlink cycle guard — own ancestor only
            return None
        ancestors = ancestors | {rp}
        dirs: list[dict] = []
        files: list[dict] = []
        try:
            entries = sorted(d.iterdir(), key=lambda p: (p.name.lower(), p.name))
        except OSError:
            entries = []
        for e in entries:
            visited += 1
            if visited > MAX_ENTRIES:
                truncated = True
                break
            name = e.name
            if name.startswith("."):
                continue
            crel = f"{rel}/{name}" if rel else name
            try:
                if e.is_dir():
                    if name in IGNORE_DIRS:
                        continue
                    sub = walk(e, crel, ancestors)
                    if sub and (sub["dirs"] or sub["files"]):
                        dirs.append(sub)
                elif e.suffix.lower() in MD_EXTS and e.is_file():
                    file_count += 1
                    files.append({"name": name, "path": crel})
            except OSError:
                continue
        return {"name": d.name or str(d), "path": rel, "dirs": dirs, "files": files}

    tree = walk(root, "", frozenset()) or {"name": root.name or str(root), "path": "", "dirs": [], "files": []}
    return {
        "root": root.name or str(root),
        "rootPath": str(root),
        "tree": tree,
        "count": file_count,
        "truncated": truncated,
    }


class MdViewServer(ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, addr, handler, root: Path, verbose: bool):
        super().__init__(addr, handler)
        self.root = root
        self.verbose = verbose
        # 루프백 바인딩이면 Host 헤더를 화이트리스트로 검증한다 — DNS rebinding으로
        # 임의 웹페이지가 이 서버를 same-origin처럼 읽는 것을 막는다.
        self.allowed_hosts = LOOPBACK_HOSTS if addr[0] in LOOPBACK_HOSTS else None
        self._tree: dict | None = None
        self._tree_ts = 0.0
        self._tree_lock = threading.Lock()

    def get_tree(self) -> dict:
        with self._tree_lock:
            now = time.time()
            if self._tree is None or now - self._tree_ts > 2.0:
                self._tree = scan_tree(self.root)
                self._tree_ts = now
            return self._tree


class Handler(BaseHTTPRequestHandler):
    server_version = "mdview/" + VERSION
    protocol_version = "HTTP/1.1"

    # ── plumbing ──────────────────────────────────────────────

    def log_message(self, fmt, *args):  # noqa: A002
        if self.server.verbose:
            super().log_message(fmt, *args)

    def _send(self, code: int, ctype: str, body: bytes, cache: str = "no-store", head: bool = False):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", cache)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        if not head:
            self.wfile.write(body)

    def _json(self, obj, code: int = 200, head: bool = False):
        self._send(code, "application/json; charset=utf-8", json.dumps(obj).encode("utf-8"), head=head)

    def _send_file(self, path: Path, cache: str, head: bool):
        try:
            st = path.stat()
            f = path.open("rb")
        except OSError:
            self._send(404, "text/plain; charset=utf-8", b"not found", head=head)
            return
        ctype, _ = mimetypes.guess_type(str(path))
        ctype = ctype or "application/octet-stream"
        if ctype.startswith("text/"):
            ctype += "; charset=utf-8"
        with f:
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(st.st_size))
            self.send_header("Cache-Control", cache)
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            if not head:
                shutil.copyfileobj(f, self.wfile)

    # ── routes ────────────────────────────────────────────────

    def do_GET(self):
        self._handle(head=False)

    def do_HEAD(self):
        self._handle(head=True)

    def _handle(self, head: bool):
        try:
            self._route(head)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _host_ok(self) -> bool:
        allowed = self.server.allowed_hosts
        if allowed is None:
            return True
        host = self.headers.get("Host", "")
        if not host:
            return False
        if host.startswith("["):  # [::1]:8642
            name, _, rest = host.partition("]")
            name += "]"
            port = rest[1:] if rest.startswith(":") else ""
        else:
            name, _, port = host.partition(":")
        if port and port != str(self.server.server_address[1]):
            return False
        return name.lower() in allowed

    def _route(self, head: bool):
        if not self._host_ok():
            self._send(403, "text/plain; charset=utf-8", "허용되지 않은 Host 헤더입니다.".encode("utf-8"), head=head)
            return
        # http.server는 요청 라인을 latin-1로 디코드한다 — 비ASCII 원시 바이트를 UTF-8로 복원
        parsed = urlparse(self.path.encode("latin-1", "replace").decode("utf-8", "replace"))
        route = unquote(parsed.path)
        root: Path = self.server.root

        if route == "/":
            self._send(200, "text/html; charset=utf-8", PAGE_HTML.encode("utf-8"), head=head)
            return
        if route == "/api/tree":
            self._json(self.server.get_tree(), head=head)
            return
        if route in ("/api/file", "/api/stat"):
            qs = parse_qs(parsed.query)
            rel = (qs.get("path") or [""])[0]
            p = safe_path(root, rel)
            if p is None or p.suffix.lower() not in MD_EXTS or not p.is_file():
                self._json({"error": "not found", "path": rel}, code=404, head=head)
                return
            try:
                mtime = p.stat().st_mtime
                if route == "/api/stat":
                    self._json({"path": rel, "mtime": mtime}, head=head)
                else:
                    content = p.read_text("utf-8", errors="replace")
                    self._json({"path": rel, "mtime": mtime, "content": content}, head=head)
            except OSError:
                self._json({"error": "unreadable", "path": rel}, code=500, head=head)
            return
        if route.startswith("/assets/"):
            name = route[len("/assets/"):]
            if name not in ASSETS:
                self._send(404, "text/plain; charset=utf-8", b"unknown asset", head=head)
                return
            self._send_file(ASSET_DIR / name, cache="public, max-age=86400", head=head)
            return
        if route.startswith("/raw/"):
            p = safe_path(root, route[len("/raw/"):])
            if p is None or not p.is_file():
                self._send(404, "text/plain; charset=utf-8", b"not found", head=head)
                return
            self._send_file(p, cache="no-cache", head=head)
            return
        if route == "/favicon.ico":
            self._send(204, "image/x-icon", b"", head=head)
            return
        self._send(404, "text/plain; charset=utf-8", b"not found", head=head)


