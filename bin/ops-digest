#!/usr/bin/env python3
"""ops-digest — 통합 이벤트 스트림을 읽어 의사결정용 다이제스트를 생성.

`ops-event` 가 쌓은 ~/.local/state/ops/events/*.jsonl 를 롤업해,
백그라운드 잡들에서 "무슨 일이 있었고 무엇을 결정해야 하는가"를 한 곳에 보여준다.

표면화하는 결정 신호:
  - 침묵 감지: 과거엔 돌던 잡이 최근 창에서 이벤트가 없음 → launchagent 고장 의심
  - 오류: kind=error 이벤트
  - 주의 필요 발견: severity>=medium 인 finding
  - 지표 추세: 숫자 payload 필드의 min/last/max (예: usedPercent 상승)

사용법:
  ops-digest                 # 최근 7일, 마크다운을 stdout 으로
  ops-digest --days 14
  ops-digest --json          # 기계 판독용 JSON
  ops-digest --out PATH      # 파일로도 기록 (예: mimir 볼트)
"""
from __future__ import annotations

import argparse
import datetime as _dt
import glob
import json
import os
import platform
import shutil
import subprocess
import sys
import urllib.parse
from collections import defaultdict

SEVERITY_RANK = {"info": 0, "low": 1, "medium": 2, "high": 3}
# 침묵 감지: 과거(롤백 창)엔 있었는데 최근 창에 없는 소스를 찾기 위한 되돌아보기.
SILENCE_LOOKBACK_DAYS = 30
# 침묵 오탐 교정(2026-08-12 감사). 경보 4건 중 3건이 오탐이었고, 그러면
# 사람이 다이제스트를 안 읽게 된다. 세 가지가 빠져 있었다.
#
# ① 이름이 바뀐 잡. 옛 소스명이 롤백 창에만 남아 영원히 침묵으로 뜬다.
#    비어 있어도 둔다. 개명할 때 여기 한 줄이 오탐을 막는다.
#    주의: harvest-sessions(1단계 추출)와 session-harvest(2단계 마이닝)는
#    이름이 닮았을 뿐 서로 다른 잡이다. 별칭으로 묶지 않는다.
SOURCE_ALIASES: dict[str, str] = {}
# ② 잡이 아닌 소스, 그리고 은퇴한 잡. 감시 대상이 아니다.
#    새로 은퇴시킬 때는 여기에 사유와 날짜를 남긴다.
SILENCE_EXEMPT = {
    # 스킬이 실행할 때만 도는 도구다. launchd 잡이 아니다.
    "agent-os-review-due",
    # 2026-07-22 은퇴. session-harvest-weekly 가 대체(install.sh 가 bootout 한다).
    "personal-ops-weekly",
}
# ③ 할 일이 없어 조용한 잡. "아무것도 안 함"을 성공으로 남기는 규약이
#    하트비트다. 침묵 판정에는 쓰되 이벤트/실행 수로는 세지 않는다.
HEARTBEAT_KIND = "heartbeat"
# 스냅샷 신선도(2026-08-05 감사 A.2): 시간당 잡이므로 24h 무소식은 확실한 고장이다.
SNAPSHOT_SOURCE = "vault-snapshot"
SNAPSHOT_STALE_HOURS = 24


def state_root() -> str:
    override = os.environ.get("OPS_STATE_DIR")
    if override:
        return os.path.expanduser(override)
    xdg = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(xdg, "ops")


def load_events(events_dir: str) -> list[dict]:
    events = []
    for path in sorted(glob.glob(os.path.join(events_dir, "*.jsonl"))):
        try:
            with open(path, encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        events.append(json.loads(line))
                    except json.JSONDecodeError:
                        continue
        except OSError:
            continue
    return events


def parse_ts(ev: dict):
    try:
        return _dt.datetime.fromisoformat(ev["ts"])
    except (KeyError, ValueError):
        return None


def numeric_fields(ev: dict) -> dict:
    reserved = {"schema_version", "ts", "source", "kind", "severity"}
    return {
        k: v
        for k, v in ev.items()
        if k not in reserved and isinstance(v, (int, float)) and not isinstance(v, bool)
    }


def snapshot_freshness(events: list[dict], now: _dt.datetime) -> list[str]:
    """볼트 스냅샷(백업 경로)의 침묵 실패를 표면화한다.

    일반 침묵 감지(7일 창)로는 백업 정지를 하루 안에 못 잡는다 — 이 잡만
    24h 기준을 따로 둔다. 경보 셋: ① 잡 침묵 24h+ ② 커밋은 있는데 push 성공
    0(로컬에만 있는 변경이 하루 초과) ③ pull 충돌(사람이 풀 때까지 동기화 정지)."""
    dated = [(parse_ts(e), e) for e in events if e.get("source") == SNAPSHOT_SOURCE]
    dated = [(ts, e) for ts, e in dated if ts is not None]
    if not dated:
        return []  # 이 기기에서 돈 적 없는 잡 — 일반 침묵 섹션의 몫
    cutoff = now - _dt.timedelta(hours=SNAPSHOT_STALE_HOURS)
    recent = [e for ts, e in dated if ts >= cutoff]
    if not recent:
        last_ts = max(ts for ts, _ in dated)
        return [f"스냅샷 잡 침묵 {SNAPSHOT_STALE_HOURS}h+ — 마지막 실행 {last_ts.isoformat()[:16]}"]

    def count(ev: dict, key: str):
        # 수동 백필 등으로 비숫자 값이 섞여도 다이제스트가 죽으면 안 된다
        v = ev.get(key, 0)
        return v if isinstance(v, (int, float)) and not isinstance(v, bool) else 0

    problems = []
    committed = sum(count(e, "committed") for e in recent)
    pushed = sum(count(e, "pushed") for e in recent)
    push_failed = sum(count(e, "push_failed") for e in recent)
    conflicted = sum(count(e, "conflicted") for e in recent)
    if committed and not pushed:
        problems.append(
            f"커밋 {committed}건이 {SNAPSHOT_STALE_HOURS}h째 원격 미반영"
            f" (push 실패 {push_failed}회) — 오프디바이스 백업 정지"
        )
    elif len(recent) >= 3 and all(count(e, "push_failed") > 0 for e in recent):
        # 이벤트는 볼트 합산이라 한 볼트가 고착돼도 다른 볼트의 성공이 pushed를
        # 채운다 — 전 실행에서 push_failed가 지속되는 패턴이 단일 볼트 고장 신호다.
        problems.append(
            f"push 실패가 최근 {len(recent)}회 실행 전부에서 지속 (합 {push_failed}회)"
            " — 볼트 하나가 원격 미반영으로 고착 의심"
        )
    if conflicted:
        problems.append(f"pull 충돌 {conflicted}회 — 해당 볼트는 수동 해소 전까지 동기화 정지")
    return problems


def build_digest(events: list[dict], days: int, now: _dt.datetime) -> dict:
    window_start = now - _dt.timedelta(days=days)
    lookback_start = now - _dt.timedelta(days=SILENCE_LOOKBACK_DAYS)

    recent_sources: set[str] = set()
    prior_sources: set[str] = set()
    last_seen: dict[str, str] = {}
    per_source = defaultdict(lambda: {
        "runs": 0, "events": 0, "errors": 0,
        "findings": [], "metrics": defaultdict(list),
    })
    errors = []
    findings = []

    for ev in events:
        ts = parse_ts(ev)
        if ts is None:
            continue
        src = ev.get("source", "?")
        src = SOURCE_ALIASES.get(src, src)
        if ts >= lookback_start:
            prior_sources.add(src)
        if ts < window_start:
            continue
        recent_sources.add(src)
        iso = ev["ts"]
        if src not in last_seen or iso > last_seen[src]:
            last_seen[src] = iso

        kind = ev.get("kind", "run")
        if kind == HEARTBEAT_KIND:
            # 살아 있다는 신호일 뿐이다. 위 recent_sources 등록으로 제 몫을
            # 다했으니 여기서 끝낸다. 요약 표를 하트비트로 채우지 않는다.
            continue

        s = per_source[src]
        s["events"] += 1
        if kind == "run":
            s["runs"] += 1
        elif kind == "error":
            s["errors"] += 1
            errors.append(ev)
        elif kind == "finding":
            s["findings"].append(ev)
            if SEVERITY_RANK.get(ev.get("severity", "info"), 0) >= SEVERITY_RANK["medium"]:
                findings.append(ev)
        for field, val in numeric_fields(ev).items():
            s["metrics"][field].append(val)

    silent = sorted(prior_sources - recent_sources - SILENCE_EXEMPT)

    # metrics 를 min/last/max 로 축약
    for src, s in per_source.items():
        trends = {}
        for field, vals in s["metrics"].items():
            trends[field] = {"min": min(vals), "last": vals[-1], "max": max(vals), "n": len(vals)}
        s["metrics"] = trends
        s["findings"] = len(s["findings"])

    return {
        "generated_at": now.isoformat(),
        "window_days": days,
        "sources_active": sorted(recent_sources),
        "sources_silent": silent,
        "snapshot_freshness": snapshot_freshness(events, now),
        "per_source": {k: dict(v) for k, v in per_source.items()},
        "last_seen": last_seen,
        "errors": errors,
        "findings_attention": sorted(
            findings, key=lambda e: -SEVERITY_RANK.get(e.get("severity", "info"), 0)
        ),
    }


def event_message(ev: dict) -> str:
    """사람이 읽을 한 줄. message류 키가 없으면 payload를 k=v로 압축한다.

    발신부가 message를 안 넣으면 이 섹션들이 통째로 공백이 되던 문제의
    방어선(2026-08-04 감사: 오류 34줄·발견 13줄 전부 빈 텍스트).
    """
    for key in ("message", "detail", "error", "title"):
        value = ev.get(key)
        if value:
            return str(value)
    reserved = {"schema_version", "ts", "source", "kind", "severity"}
    pairs = [f"{k}={ev[k]}" for k in ev if k not in reserved]
    return " ".join(pairs[:8])


def grouped(events: list[dict]) -> list[tuple[str, str, str, int, str]]:
    """(source, severity, message)로 묶어 건수 내림차순 목록을 만든다.

    만성 실패(예: 15분 주기 잡의 동일 오류)가 수백 줄로 다른 신호를
    덮지 않게 '같은 얘기 ×N'으로 접는다.
    """
    groups: dict[tuple[str, str, str], list[str]] = defaultdict(list)
    for ev in events:
        key = (ev.get("source", "?"), ev.get("severity", "info"), event_message(ev))
        groups[key].append(ev.get("ts", ""))
    return sorted(
        (
            (src, sev, msg, len(ts_list), max(ts_list))
            for (src, sev, msg), ts_list in groups.items()
        ),
        key=lambda item: -item[3],
    )


def render_markdown(d: dict) -> str:
    lines = []
    lines.append(f"# 백그라운드 잡 다이제스트 — 최근 {d['window_days']}일")
    lines.append("")
    lines.append(f"생성: {d['generated_at'][:19]}  ·  활성 소스 {len(d['sources_active'])}개")
    lines.append("")

    # 결정 신호 먼저 (요약 우선)
    if d.get("snapshot_freshness"):
        lines.append("## 🧊 스냅샷 신선도 경보 (백업 경로 점검)")
        for msg in d["snapshot_freshness"]:
            lines.append(f"- {msg}")
        lines.append("")
    if d["sources_silent"]:
        lines.append("## ⚠️ 침묵한 잡 (launchagent 점검 권장)")
        for src in d["sources_silent"]:
            lines.append(f"- **{src}** — 최근 {d['window_days']}일 이벤트 없음")
        lines.append("")
    if d["errors"]:
        lines.append(f"## 🔴 오류 {len(d['errors'])}건")
        for src, _sev, msg, count, last in grouped(d["errors"])[:10]:
            suffix = f" ×{count}" if count > 1 else ""
            lines.append(f"- `{src}` {last[:19]} — {msg}{suffix}")
        lines.append("")
    if d["findings_attention"]:
        lines.append(f"## 🟡 주의 필요 발견 {len(d['findings_attention'])}건")
        for src, sev, msg, count, last in grouped(d["findings_attention"])[:15]:
            suffix = f" ×{count}" if count > 1 else ""
            lines.append(f"- [{sev}] `{src}` {last[:19]} — {msg}{suffix}")
        lines.append("")

    lines.append("## 잡별 요약")
    lines.append("")
    lines.append("| 소스 | 실행 | 이벤트 | 오류 | 발견 | 마지막 |")
    lines.append("|---|--:|--:|--:|--:|---|")
    for src in sorted(d["per_source"]):
        s = d["per_source"][src]
        last = d["last_seen"].get(src, "")[:16]
        lines.append(
            f"| {src} | {s['runs']} | {s['events']} | {s['errors']} | {s['findings']} | {last} |"
        )
    lines.append("")

    # 지표 추세
    trend_rows = []
    for src in sorted(d["per_source"]):
        for field, t in d["per_source"][src].get("metrics", {}).items():
            arrow = "→"
            if t["last"] > t["min"] and t["last"] >= t["max"]:
                arrow = "↑"
            elif t["last"] < t["max"] and t["last"] <= t["min"]:
                arrow = "↓"
            trend_rows.append((src, field, t, arrow))
    if trend_rows:
        lines.append("## 지표 추세 (min → last / max)")
        lines.append("")
        for src, field, t, arrow in trend_rows:
            lines.append(f"- `{src}.{field}` {arrow} {t['min']} → **{t['last']}** / {t['max']}  (n={t['n']})")
        lines.append("")

    if not d["per_source"]:
        lines.append("_이 창에 이벤트 없음._")
        lines.append("")
    return "\n".join(lines)


def resolve_out_path(raw: str) -> str:
    """--out의 {host} 토큰을 짧은 호스트명으로 치환한다.

    같은 plist가 맥북·아이맥 두 기기에 설치된다. 고정 파일명이면 두 기기가
    매일 밤 같은 vault 파일을 써서 스냅샷 pull --rebase가 충돌한다(2026-07-26
    세션 수확 both-added 실사고와 동형). 기기별 파일로 갈라 원천 차단한다.
    """
    return os.path.expanduser(raw).replace("{host}", platform.node().split(".")[0])


def notify_digest(d: dict, out_path: str | None) -> None:
    """신호(오류·주의 발견·침묵)가 있을 때만 agent-notify로 1줄 알린다.

    0건인 날은 조용히 — 매일 오는 무신호 알림은 그 자체가 새 소음이다.
    알림 실패가 다이제스트 생성을 깨뜨리면 안 된다.
    """
    errors = len(d["errors"])
    findings = len(d["findings_attention"])
    silent = len(d["sources_silent"])
    fresh = len(d.get("snapshot_freshness", []))
    if not (errors or findings or silent or fresh):
        return
    executable = shutil.which("agent-notify") or os.path.expanduser(
        "~/.local/bin/agent-notify"
    )
    if not os.access(executable, os.X_OK):
        return
    message = f"잡 다이제스트: 오류 {errors} · 발견 {findings} · 침묵 {silent}"
    if fresh:
        message += f" · 🧊신선도 {fresh}"
    if out_path:
        encoded = urllib.parse.quote(out_path, safe="")
        message += f" · <obsidian://open?path={encoded}|열기>"
    try:
        subprocess.run(
            [
                executable, "event",
                "--source", "ops-digest",
                "--label", "Ops Digest",
                "--status", "attention" if errors or silent or fresh else "complete",
                "--project", message,
                "--local", "off",
                "--slack", "immediate",
            ],
            check=False,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def main() -> int:
    parser = argparse.ArgumentParser(prog="ops-digest")
    parser.add_argument("--days", type=int, default=7)
    parser.add_argument("--json", action="store_true", help="마크다운 대신 JSON 출력")
    parser.add_argument("--out", default=None, help="stdout 외에 이 경로로도 기록")
    parser.add_argument("--now", default=None, help="iso8601 기준시각 override (테스트용)")
    parser.add_argument(
        "--notify", action="store_true", help="신호가 있을 때만 agent-notify 1줄 발신"
    )
    args = parser.parse_args()

    now = _dt.datetime.fromisoformat(args.now) if args.now else _dt.datetime.now().astimezone()
    events = load_events(os.path.join(state_root(), "events"))
    digest = build_digest(events, args.days, now)

    out = json.dumps(digest, ensure_ascii=False, indent=2) if args.json else render_markdown(digest)
    sys.stdout.write(out + "\n")
    out_path = None
    if args.out:
        out_path = resolve_out_path(args.out)
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        with open(out_path, "w", encoding="utf-8") as fh:
            if not args.json:
                # 마크다운 산출물은 mimir 볼트 노트로 소비된다 — 로그 타입은 생성 시 종결 status
                fh.write(
                    "---\n"
                    "type: digest\n"
                    "status: archived\n"
                    "origin: agent\n"
                    f"created: {now.date().isoformat()}\n"
                    "---\n\n"
                )
            fh.write(out + "\n")
    if args.notify:
        notify_digest(digest, out_path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
