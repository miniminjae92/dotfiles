#!/usr/bin/env python3
"""simulator-reaper — 잊고 놔둔 iOS 시뮬레이터를 회수한다.

시뮬레이터 기기는 Simulator.app 창을 닫아도, Xcode를 종료해도 계속 돈다.
`launchd_sim`이 SpringBoard·Photos·Mail 등 iOS 데몬 200여 개를 띄운 채
남아 기기 한 대가 10GB 넘게 점유하므로, 개발 도구가 모두 꺼진 뒤에도
살아 있으면 여기서 종료한다.

기기의 켜짐/꺼짐은 device.plist에 저장된다. 깨끗하게 안 꺼지면 "켜짐"으로
눌어붙어 CoreSimulatorService가 다음 시작 때 그대로 되살리므로, Xcode를
쓰지 않아도 혼자 부활한다. 이 잡은 그 상태를 끊는다.

작업 중에는 개입하지 않는다. Xcode·Simulator.app·xcodebuild·xctest 중
하나라도 떠 있으면 아무것도 하지 않는다. 도구가 전부 꺼진 뒤에도 유예
시간을 넘겨 살아 있는 기기만 종료 대상이다.

환경변수:
  SIMULATOR_REAPER_GRACE_SECONDS  유예 시간 (기본 900)
  SIMULATOR_REAPER_DRY_RUN        1이면 종료하지 않고 대상만 보고
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# 개발 도구가 하나라도 살아 있으면 시뮬레이터는 사용 중일 수 있다.
GUARD_PATTERNS = (
    "Xcode.app/Contents/MacOS/Xcode",
    "Simulator.app/Contents/MacOS/Simulator",
)
GUARD_COMMANDS = ("xcodebuild", "xctest")
DEFAULT_GRACE_SECONDS = 900
SIMCTL_FALLBACK = "/Applications/Xcode.app/Contents/Developer/usr/bin/simctl"


def run(command: list[str], timeout: int = 30) -> subprocess.CompletedProcess | None:
    try:
        return subprocess.run(
            command, capture_output=True, text=True, timeout=timeout, check=False
        )
    except (OSError, subprocess.SubprocessError):
        return None


def emit_ops_event(kind: str, severity: str = "info", **fields: object) -> None:
    """ops-event 로 구조화 이벤트 1줄 append. 실패해도 잡을 깨지 않는다."""
    exe = shutil.which("ops-event") or str(Path.home() / ".local/bin/ops-event")
    pairs = [f"{key}={value}" for key, value in fields.items()]
    run([exe, "--source", "simulator-reaper", "--kind", kind, "--severity", severity, *pairs])


def simctl_path() -> str | None:
    """xcode-select가 CommandLineTools를 가리키면 simctl이 없으므로 폴백한다."""
    result = run(["/usr/bin/xcrun", "--find", "simctl"], timeout=10)
    if result and result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip()
    return SIMCTL_FALLBACK if os.access(SIMCTL_FALLBACK, os.X_OK) else None


def running(pattern: str, exact: bool = False) -> bool:
    result = run(["/usr/bin/pgrep", "-x" if exact else "-f", pattern], timeout=10)
    return bool(result and result.returncode == 0)


def active_developer_tool() -> str | None:
    for pattern in GUARD_PATTERNS:
        if running(pattern):
            return pattern.split("/")[-1]
    for command in GUARD_COMMANDS:
        if running(command, exact=True):
            return command
    return None


def parse_etime(value: str) -> int:
    """ps의 etime(`[[dd-]hh:]mm:ss`)을 초로 바꾼다."""
    days = 0
    if "-" in value:
        day_part, _, value = value.partition("-")
        days = int(day_part)
    parts = [int(part) for part in value.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    hours, minutes, seconds = parts
    return days * 86400 + hours * 3600 + minutes * 60 + seconds


def youngest_sim_age_seconds() -> int | None:
    """가장 최근에 뜬 launchd_sim의 나이. 하나라도 어리면 유예한다."""
    result = run(["/bin/ps", "-Axo", "etime=,comm="], timeout=10)
    if not result or result.returncode != 0:
        return None
    ages = []
    for line in result.stdout.splitlines():
        fields = line.split(None, 1)
        if len(fields) < 2 or Path(fields[1].strip()).name != "launchd_sim":
            continue
        try:
            ages.append(parse_etime(fields[0]))
        except ValueError:
            continue
    return min(ages) if ages else None


def booted_devices(simctl: str) -> list[dict[str, str]]:
    result = run([simctl, "list", "devices", "booted", "-j"], timeout=30)
    if not result or result.returncode != 0:
        return []
    try:
        payload = json.loads(result.stdout)
    except ValueError:
        return []
    return [
        {"name": device.get("name", "?"), "udid": device.get("udid", "?")}
        for devices in payload.get("devices", {}).values()
        for device in devices
        if device.get("state") == "Booted"
    ]


def main() -> int:
    simctl = simctl_path()
    if not simctl:
        print("simulator-reaper: simctl을 찾지 못했습니다.", file=sys.stderr)
        return 1

    devices = booted_devices(simctl)
    if not devices:
        return 0

    names = ", ".join(device["name"] for device in devices)

    tool = active_developer_tool()
    if tool:
        # 사용 중이다. 조용히 물러난다.
        return 0

    grace = int(os.environ.get("SIMULATOR_REAPER_GRACE_SECONDS", DEFAULT_GRACE_SECONDS))
    age = youngest_sim_age_seconds()
    if age is not None and age < grace:
        return 0

    if os.environ.get("SIMULATOR_REAPER_DRY_RUN") == "1":
        print(f"simulator-reaper: [dry-run] 종료 대상 {len(devices)}대 — {names}")
        return 0

    result = run([simctl, "shutdown", "all"], timeout=60)
    if not result or result.returncode != 0:
        detail = (result.stderr.strip()[:200] if result else "실행 실패")
        print(f"simulator-reaper: 종료 실패 — {detail}", file=sys.stderr)
        emit_ops_event("error", severity="low", devices=len(devices), detail="shutdown-failed")
        return 1

    remaining = len(booted_devices(simctl))
    print(f"simulator-reaper: 유휴 시뮬레이터 {len(devices)}대 종료 — {names}")
    emit_ops_event(
        "run",
        severity="low",
        reaped=len(devices),
        remaining=remaining,
        idle_seconds=age if age is not None else -1,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
